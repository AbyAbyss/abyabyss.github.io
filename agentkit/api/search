":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"containerImage"},"197":{"id":"/docs/config-reference-195","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"—"},"198":{"id":"/docs/config-reference-196","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Image when isolation: \"container\""},"199":{"id":"/docs/config-reference-197","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"allowNetwork"},"200":{"id":"/docs/config-reference-198","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"false"},"201":{"id":"/docs/config-reference-199","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"run_command's network: false none, true always, \"ask\" offline until a command sets network: true, which then waits for the user's approval (whatever the approval policy) and runs with the network on for that call only"},"202":{"id":"/docs/config-reference-200","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"allowSensitiveReads"},"203":{"id":"/docs/config-reference-201","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"—"},"204":{"id":"/docs/config-reference-202","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Filenames allowed past the secret-file read block (.env, keys…)"},"205":{"id":"/docs/config-reference-203","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"artifacts"},"206":{"id":"/docs/config-reference-204","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"off"},"207":{"id":"/docs/config-reference-205","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"true or { dir?, persist? } — surface scratch files as result.artifacts + artifact:produced events"},"208":{"id":"/docs/config-reference-206","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Paths scratch/... or @scratch/... use the session scratch dir. Other paths use the project root. When project: false, unprefixed paths resolve to scratch. Scratch is cleaned up on session.close()."},"209":{"id":"/docs/config-reference-207","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"When artifacts is enabled, files the agent writes to scratch are returned in result.artifacts ({ id, path, mime, bytes }) and emitted as artifact:produced events. With persist (default on for object form) they are copied under .agentkit/artifacts/<sessionId>/ so they survive scratch cleanup, and @agentkit/server serves them at GET /artifacts/:sessionId/:id. See SECURITY.md for the isolation model."},"210":{"id":"/docs/config-reference-208","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#built-in-tools-builtins","content":"Opt-in groups. Prefer workspace for filesystem/shell. builtins.groups.filesystem|shell is shimmed to workspace (deprecation warning once)."},"211":{"id":"/docs/config-reference-209","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#built-in-tools-builtins","content":"Group"},"212":{"id":"/docs/config-reference-210","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#built-in-tools-builtins","content":"Tools"},"213":{"id