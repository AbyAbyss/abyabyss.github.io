s/extend-86","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#where-to-reach","content":"get provider keys from a vault, not the environment"},"1987":{"id":"/docs/extend-87","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#where-to-reach","content":"a ctx.credentials provider"},"1988":{"id":"/docs/extend-88","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#where-to-reach","content":"name a whole deployment's composition"},"1989":{"id":"/docs/extend-89","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#where-to-reach","content":"defineProfile + mountProfile"},"1990":{"id":"/docs/extend-90","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"You can import everything from @agentkit/core, which re-exports the spine. The two packages underneath are published separately for anyone who wants the substrate without the batteries:"},"1991":{"id":"/docs/extend-91","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"package"},"1992":{"id":"/docs/extend-92","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"contains"},"1993":{"id":"/docs/extend-93","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"@agentkit/kernel"},"1994":{"id":"/docs/extend-94","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"contexts, services, reversible effects, inject, a five-mode event bus, bundles. Nothing agent-specific."},"1995":{"id":"/docs/extend-95","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"@agentkit/runtime"},"1996":{"id":"/docs/extend-96","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"the agent microkernel on that kernel: session log, tool pipeline, prompt assembly, model seam, replaceable loop."},"1997":{"id":"/docs/extend-97","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"@agentkit/core"},"1998":{"id":"/docs/extend-98","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"both of the above, plus the Node-side providers and every battery — nodeExecution, nodeTerminals, fetchWeb, fileSpill, settingsFiles, sessionPersistence, nodeCodeRuntime, hooks."},"1999":{"id":"/docs/extend-99","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#packages","content":"Edge and worker targets can depend on @agentkit/runtime alone; the Node-only pieces (SQLite persistence, node:vm Code Mode, real fs/subprocess) live in @agentkit/core."},"2000":{"id":"/docs/extend-100","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Plugin kernel — contexts, effects, inject, dispatch modes, realms"},"2001":{"id":"/docs/extend-101","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Agent runtime — services, the turn, every extension point"},"2002":{"id":"/docs/extend-102","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Session log — why model-visible means logged"},"2003":{"id":"/docs/extend-103","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Tool contract — one definition, four consumers"},"2004":{"id":"/docs/extend-104","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Capability seams — shells, jobs, commands, todos, web, LSP, spill"},"2005":{"id":"/docs/extend-105","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Execution seams — filesystem, subprocess, sandboxing"},"2006":{"id":"/docs/extend-106","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Code Mode — the model writes a program instead of a call"},"2007":{"id":"/docs/extend-107","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Context engineering — deferred tools, approval by annotation, compaction, spill, dynamic subagents"},"2008":{"id":"/docs/extend-108","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Bundles — a composition as data, patchable by id"},"2009":{"id":"/docs/extend-109","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Configuration — profiles, layered settings, hooks, credentials"},"2010":{"id":"/docs/extend-110","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Case study: mini-harness — a coding agent built only from these APIs"},"2011":{"id":"/docs/extend-111","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Case study: the grand tour — every feature in one bundle, twenty-two verified stops"},"2012":{"id":"/docs/extend-112","page_id":"/docs/extend","tags":[],"type":"text","url":"/docs/extend#next-steps","content":"Building a coding agent — what the spine gives a Claude Code-style product, what stays yours, what is missing"},"2013":{"id":"/docs/extend/kernel","page_id":"/docs/extend/kernel","type":"page","content":"Plugin kernel","breadcrumbs":["Documentation","Extending"],"tags":[],"url":"/docs/extend/kernel"},"2014":{"id":"/docs/extend/kernel-0","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel","content":"Contexts, reversible effects, inject, dispatch modes, and realms"},"2015":{"id":"/docs/extend/kernel-1","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#a-context-with-services","content":"A context with services"},"2016":{"id":"/docs/extend/kernel-2","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#reversible-effects","content":"Reversible effects"},"2017":{"id":"/docs/extend/kernel-3","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#inject--dependencies-across-time","content":"inject — dependencies across time"},"2018":{"id":"/docs/extend/kernel-4","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#five-dispatch-modes","content":"Five dispatch modes"},"2019":{"id":"/docs/extend/kernel-5","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#realms","content":"Realms"},"2020":{"id":"/docs/extend/kernel-6","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#services-and-thisctx","content":"Services and this.ctx"},"2021":{"id":"/docs/extend/kernel-7","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#config","content":"Config"},"2022":{"id":"/docs/extend/kernel-8","page_id":"/docs/extend/kernel","type":"heading","tags":[],"url":"/docs/extend/kernel#next","content":"Next"},"2023":{"id":"/docs/extend/kernel-9","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel","content":"@agentkit/kernel is the composition substrate under AgentKit. Nothing in it is agent-specific — it is contexts, services, plugin lifecycles, and events. You do not need it to use AgentKit; you need it to extend AgentKit without asking anyone's permission."},"2024":{"id":"/docs/extend/kernel-10","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel","content":"Everything on this page is also re-exported from @agentkit/core."},"2025":{"id":"/docs/extend/kernel-11","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel","content":"runtime.start() resolves once the tree has settled — every plugin whose dependencies exist has loaded."},"2026":{"id":"/docs/extend/kernel-12","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#a-context-with-services","content":"A service published at ctx.<name> is reachable by every plugin in the tree. Augment the Services interface to type it:"},"2027":{"id":"/docs/extend/kernel-13","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#a-context-with-services","content":"After that, ctx.tools is typed everywhere, with no registry lookup and no casts."},"2028":{"id":"/docs/extend/kernel-14","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#reversible-effects","content":"Everything a plugin registers is owned by that plugin and unwinds when it unloads — in reverse order, so a later effect that depends on an earlier one is torn down first."},"2029":{"id":"/docs/extend/kernel-15","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#reversible-effects","content":"ctx.on, ctx.provide, and every registry method built on ctx.effect inherit this, so a plugin author almost never writes cleanup by hand. Unloading a plugin genuinely removes it — no orphaned listeners, no stale services."},"2030":{"id":"/docs/extend/kernel-16","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#inject--dependencies-across-time","content":"A dependency here is a relationship over time, not a startup-order constraint. The plugin loads when its dependencies appear, unloads when one disappears, and reloads when it comes back."},"2031":{"id":"/docs/extend/kernel-17","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#inject--dependencies-across-time","content":"An optional dependency does not block loading but still triggers a reload when it changes, so \"use telemetry if it is mounted\" is a first-class relationship rather than a nullable lookup scattered through the body."},"2032":{"id":"/docs/extend/kernel-18","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#inject--dependencies-across-time","content":"runtime.pending() lists what has not loaded and what it is waiting for — the first thing to check when a plugin seems inert."},"2033":{"id":"/docs/extend/kernel-19","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"mode"},"2034":{"id":"/docs/extend/kernel-20","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"shape"},"2035":{"id":"/docs/extend/kernel-21","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"emit"},"2036":{"id":"/docs/extend/kernel-22","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"fire and forget; a throwing listener is contained"},"2037":{"id":"/docs/extend/kernel-23","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"parallel"},"2038":{"id":"/docs/extend/kernel-24","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"await all, aggregate failures"},"2039":{"id":"/docs/extend/kernel-25","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"serial"},"2040":{"id":"/docs/extend/kernel-26","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"sequential, first non-nullish result wins"},"2041":{"id":"/docs/extend/kernel-27","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"bail"},"2042":{"id":"/docs/extend/kernel-28","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"synchronous short-circuit"},"2043":{"id":"/docs/extend/kernel-29","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"waterfall"},"2044":{"id":"/docs/extend/kernel-30","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"middleware chain; each listener receives next()"},"2045":{"id":"/docs/extend/kernel-31","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"waterfall is the one that turns an observation channel into an extension point. A waterfall carries one named input object, so adding a field later never breaks the plugins already listening on it:"},"2046":{"id":"/docs/extend/kernel-32","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#five-dispatch-modes","content":"Listener order is explicit rather than accidental — pass { prepend: true } to run before the plugins already registered."},"2047":{"id":"/docs/extend/kernel-33","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#realms","content":"ctx.isolate(name) gives a subtree its own instance of one service. Everything else still comes from the tree above it."},"2048":{"id":"/docs/extend/kernel-34","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#realms","content":"This is how a restricted subagent genuinely cannot reach its parent's tools, rather than being asked nicely not to. A derived tool registry inherits its parent's guards (so invariants cannot be escaped by moving into a realm) while owning its own filters (so narrowing stays local)."},"2049":{"id":"/docs/extend/kernel-35","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#services-and-thisctx","content":"A service is read through the reader's own context, so a registration made inside a service method belongs to the calling plugin:"},"2050":{"id":"/docs/extend/kernel-36","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#services-and-thisctx","content":"Because callers see a per-context view, keep mutable service state in fields holding objects (Map, Set, array, or a shared object). this.items.set(k, v) mutates the shared instance; this.count = 1 would write to one caller's view and be invisible to everyone else."},"2051":{"id":"/docs/extend/kernel-37","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#config","content":"A plugin may declare a schema. Zod works directly, and so does anything else with a parse:"},"2052":{"id":"/docs/extend/kernel-38","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#config","content":"A config that fails to parse fails that plugin's fiber and leaves the rest of the tree running — one bad row does not take down the harness."},"2053":{"id":"/docs/extend/kernel-39","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#next","content":"Agent runtime — the services and extension points built on this"},"2054":{"id":"/docs/extend/kernel-40","page_id":"/docs/extend/kernel","tags":[],"type":"text","url":"/docs/extend/kernel#next","content":"Bundles — the same composition expressed as patchable data"},"2055":{"id":"/docs/extend/mini-harness","page_id":"/docs/extend/mini-harness","type":"page","content":"Case study: mini-harness","breadcrumbs":["Documentation","Extending"],"tags":[],"url":"/docs/extend/mini-harness"},"2056":{"id":"/docs/extend/mini-harness-0","page_id":"/docs/extend/mini-harness","tags":[],"type":"text","url":"/docs/extend/mini-harness","content":"A terminal coding agent built only from public plugin APIs"},"2057":{"id":"/docs/extend/mini-harness-1","page_id":"/docs/extend/mini-harness","type":"heading","tags":[],"url":"/docs/extend/mini-harness#what-each-plugin-proves","content":"What each plugin proves"},"2058":{"id":"/docs/extend/mini-harness-2","page_id":"/docs/extend/mini-harness","type":"heading","tags":[],"url":"/docs/extend/mini-harness#composition","content":"Composition"},"2059":{"id":"/docs/extend/mini-harness-3","page_id":"/docs/extend/mini-harness","type":"heading","tags":[],"url