ies","content":"models.enabled mirrors capabilities.models; count and providers come from the registry."},"349":{"id":"/docs/config-reference-347","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitencoding","content":"encodeAdaptive(payload, { format?: 'auto' | 'toon' | 'json' | 'csv' })"},"350":{"id":"/docs/config-reference-348","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitencoding","content":"runEncodingBenchmark(rows?, log?)"},"351":{"id":"/docs/config-reference-349","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#ui-bindings","content":"@agentkit/react is the reference UI package. Vue and Svelte share its state logic (reducers in @agentkit/client); their components are minimal and themed CSS is upcoming."},"352":{"id":"/docs/config-reference-350","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitreact","content":"useAgentSession(url, { token?, tenant?, sessionId? }) returns { ready, client, session, status, error, on, send, approve, reject, answer, cancel, saveWorkflow, events }"},"353":{"id":"/docs/config-reference-351","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitreact","content":"State hooks over a session: useConversation, usePendingRequests, useWorkflowRun, useWorkflows, useMcp, useUsage, useEventLog, useTodos, usePlan"},"354":{"id":"/docs/config-reference-352","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitreact","content":"useModels(baseUrl, { token?, tenant? }) returns { ready, models, activeId, userConfigurable, setDefault, test, refresh }"},"355":{"id":"/docs/config-reference-353","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitreact","content":"Components: Chat, Timeline, TodoPanel, ApprovalGate, ChoiceCards, ToolList, ModelPicker, CostMeter, DevLog, WorkflowSaveDialog"},"356":{"id":"/docs/config-reference-354","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitvue","content":"useAgentSession(url, opts?) Vue composable with the same return shape as React (session is a shallowRef)"},"357":{"id":"/docs/config-reference-355","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitvue","content":"The same state composables as React, plus useModels"},"358":{"id":"/docs/config-reference-356","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitvue","content":"Components: Chat, TodoPanel, ApprovalGate, ModelPicker (minimal stubs)"},"359":{"id":"/docs/config-reference-357","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitsvelte","content":"useAgentSession(url, opts?) returns Svelte stores; call connect() from onMount"},"360":{"id":"/docs/config-reference-358","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitsvelte","content":"State stores: conversation, pendingRequests, workflowRun, workflows, mcp, usage, eventLog, todos, plan"},"361":{"id":"/docs/config-reference-359","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#agentkitsvelte","content":"Chat.svelte source scaffold; prop contracts exported from the package entry"},"362":{"id":"/docs/config-reference-360","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#python-client-agentkitclient-in-sdkspython","content":"The port of @agentkit/client: the same verbs and the models, MCP, RAG, workflows and\nartifacts APIs over the AG-UI routes, async, against a TypeScript or a Python server. Manage\nwith uv (cd sdks/python && uv sync)."},"363":{"id":"/docs/config-reference-361","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#python-client-agentkitclient-in-sdkspython","content":"It replaces the stdlib-only scaffold that lived in clients/python. The wire protocol is\nthe standard: the same client contract suite passes in both languages against both servers\n(node scripts/contract-check.mjs <ts|py client> <ts|py server>)."},"364":{"id":"/docs/core-concepts","page_id":"/docs/core-concepts","type":"page","content":"Core concepts","breadcrumbs":["Documentation"],"tags":[],"url":"/docs/core-concepts"},"365":{"id":"/docs/core-concepts-0","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts","content":"Agent, session, events, and modes"},"366":{"id":"/docs/core-concepts-1","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#two-levels","content":"Two levels"},"367":{"id":"/docs/core-concepts-2","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#agent","content":"Agent"},"368":{"id":"/docs/core-concepts-3","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#models","content":"Models"},"369":{"id":"/docs/core-concepts-4","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#session","content":"Session"},"370":{"id":"/docs/core-concepts-5","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#streaming-a-run","content":"Streaming a run"},"371":{"id":"/docs/core-concepts-6","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#events","content":"Events"},"372":{"id":"/docs/core-concepts-7","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#harness-replay","content":"Harness replay"},"373":{"id":"/docs/core-concepts-8","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#modes","content":"Modes"},"374":{"id":"/docs/core-concepts-9","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#multi-agent","content":"Multi-agent"},"375":{"id":"/docs/core-concepts-10","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#evaluation","content":"Evaluation"},"376":{"id":"/docs/core-concepts-11","page_id":"/docs/core-concepts","type":"heading","tags":[],"url":"/docs/core-concepts#resilience","content":"Resilience"},"377":{"id":"/docs/core-concepts-12","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#two-levels","content":"AgentKit has a configured level and a compositional one. createAgent(config) is the first: configuration in, agent out. Under it is a plugin kernel where every part of a turn is a service you can replace or an event you can intercept — see Extending AgentKit. The concepts below describe the configured level; both run the same tool pipeline and the same session log."},"378":{"id":"/docs/core-concepts-13","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#agent","content":"createAgent(config) returns an object with run, session, on, mcp, models, workflow, and related helpers. Configuration is validated at construction time with Zod."},"379":{"id":"/docs/core-concepts-14","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#models","content":"When provider.registry or userConfigurable is set, agent.models manages a hot-swappable registry. The active model resolves on every send() — see Models & switching."},"380":{"id":"/docs/core-concepts-15","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#session","content":"agent.session() is interactive: send, stream, on, approve, answer, cancel, close, setMode. Use this for chat UIs and long-running work with human gates. agent.setMode() applies to subsequent run() calls on the same agent instance."},"381":{"id":"/docs/core-concepts-16","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#session","content":"Switching mode emits mode:changed on the event bus (and over the wire when using @agentkit/server)."},"382":{"id":"/docs/core-concepts-17","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#streaming-a-run","content":"on() is push-based (one bus, many subscribers — ideal for UIs and @agentkit/server fan-out). agent.stream(task) and session.stream(input) are the pull-based counterpart over the same events: they start a run and return an async iterable plus a typed result promise. Both can be used together."},"383":{"id":"/docs/core-concepts-18","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#streaming-a-run","content":"The iterator ends on the terminal done/error event; on failure stream.result rejects. Breaking out of the loop (or stream.cancel()) unsubscribes — on a session.stream(), cancel() also cancels the underlying run. For a ready-made terminal view, pass the stream to streamToConsole(...)."},"384":{"id":"/docs/core-concepts-19","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#streaming-a-run","content":"Events are shared across all sessions of the same agent (one bus per agent). For isolation between concurrent conversations, create one agent per session."},"385":{"id":"/docs/core-concepts-20","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#events","content":"All subsystems publish to one typed event bus. Subscribe with agent.on or session.on. The same events map to AG-UI on the wire via @agentkit/server."},"386":{"id":"/docs/core-concepts-21","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#events","content":"Notable groups: stream:* and thinking:* for model output, tool:* / mcp:tool:* for tool calls, plan:* / todo:* for plan mode, cost:update and log for observability, mode:changed for runtime mode switches."},"387":{"id":"/docs/core-concepts-22","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#harness-replay","content":"Record sessions with harness: { enabled: true, record: \"./sessions\" }, then replay on another model via API or the agentkit-replay CLI:"},"388":{"id":"/docs/core-concepts-23","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#harness-replay","content":"See Harness and examples/cli-agent."},"389":{"id":"/docs/core-concepts-24","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"Mode"},"390":{"id":"/docs/core-concepts-25","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"Behavior"},"391":{"id":"/docs/core-concepts-26","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"direct"},"392":{"id":"/docs/core-concepts-27","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"Task in, result out"},"393":{"id":"/docs/core-concepts-28","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"ask"},"394":{"id":"/docs/core-concepts-29","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"Conversational, clarifies before acting"},"395":{"id":"/docs/core-concepts-30","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"plan"},"396":{"id":"/docs/core-concepts-31","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"Plan and todos before execution"},"397":{"id":"/docs/core-concepts-32","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"background"},"398":{"id":"/docs/core-concepts-33","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#modes","content":"Fire and forget with done event"},"399":{"id":"/docs/core-concepts-34","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#multi-agent","content":"Two composition styles. Subagents (subagents config, agentAsTool) are delegation: the parent calls an agent_<name> tool, the subagent runs in isolation, and its result returns to the parent. Handoffs (createHandoffTeam) are a control transfer: a triage agent routes the conversation to a specialist via a transfer_to_<name> tool, and that specialist takes over and answers (and may hand off again). Handoffs emit agent:handoff and run on a shared event bus, so streaming and the wire observe them. See handoffs in the reference."},"400":{"id":"/docs/core-concepts-35","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#evaluation","content":"evaluate(target, cases) runs a suite through an agent and returns a pass/fail EvalReport — assert behaviour (output, tool use, cost) like any other test, composing with vitest/jest. Built-in scorers cover text matching, tool calls, cost/step ceilings, structured-output schemas, and custom logic. See evaluating agents."},"401":{"id":"/docs/core-concepts-36","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#resilience","content":"Two opt-in guards on a run. budget sets per-run ceilings (maxCostUsd, maxTokens, maxToolCalls, maxDurationMs) and aborts with a BudgetExceededError when crossed. retry automatically retries transient provider failures (network blips, 429, 5xx, 529) with exponential backoff — only before any token is streamed, so output is never duplicated. See budget/retry in the reference."},"402":{"id":"/docs/core-concepts-37","page_id":"/docs/core-concepts","tags":[],"type":"text","url":"/docs/core-concepts#resilience","content":"See Configuration reference for the full event list."},"403":{"id":"/docs/getting-started","page_id":"/docs/getting-started","type":"page","content":"Getting started","breadcrumbs":["Documentation"],"tags":[],"url":"/docs/getting-started"},"404":{"id":"/docs/getting-started-0","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Install AgentKit and run your first agent"},"405":{"id":"/docs/getting-started-1","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#getting-started","content":"Getting started"},"406":{"id":"/docs/getting-started-2","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#install","content":"Install"},"407":{"id":"/docs/getting-started-3","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#building-with-an-ai-coding-agent","content":"Building with an AI coding agent"},"408":{"id":"/docs/getting-started-4","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#minimal-agent","content":"Minimal agent"},"409":{"id":"/docs/getting-started-5","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#presets","content":"Presets"},"410":{"id":"/docs/getting-started-6","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#interactive-session","content":"Interactive session"},"411":{"id":"/docs/getting-started-7","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#encoding-benchmark","content":"Encoding benchmark"},"412":{"id":"/docs/getting-started-8","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#browser-ui","content":"Browser UI"},"413":{"id":"/docs/getting-started-9","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#example","content":"Example"},"414":{"id":"/docs/getting-started-10","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#getting-started","content":"AgentKit is a headless TypeScript agent runtime. createAgent(config) validates config with Z