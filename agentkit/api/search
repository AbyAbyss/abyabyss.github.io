docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"Hook"},"1165":{"id":"/docs/ui/react-11","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"Returns"},"1166":{"id":"/docs/ui/react-12","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"useConversation(client, { includeNested? })"},"1167":{"id":"/docs/ui/react-13","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ messages, streaming } — each message has text, thinking?, tools, artifacts, ordered parts, status; workflow-step and subagent events stay out unless includeNested"},"1168":{"id":"/docs/ui/react-14","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"usePendingRequests(client)"},"1169":{"id":"/docs/ui/react-15","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ approvals, questions, approve, reject, answer } — a request disappears when it is settled anywhere (here, another tab, an admin console) or the run ends"},"1170":{"id":"/docs/ui/react-16","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"useWorkflowRun(client)"},"1171":{"id":"/docs/ui/react-17","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ runs, generating, savePrompt, list, run(id, input?), generate(task), refreshList }"},"1172":{"id":"/docs/ui/react-18","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"useWorkflows(client)"},"1173":{"id":"/docs/ui/react-19","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ workflows, refresh, get, remove, save }"},"1174":{"id":"/docs/ui/react-20","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"useMcp(client)"},"11