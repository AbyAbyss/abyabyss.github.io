t, url }"},"1090":{"id":"/docs/ui/client-30","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"saveWorkflow(workflowId, name)"},"1091":{"id":"/docs/ui/client-31","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"POST /saveWorkflow"},"1092":{"id":"/docs/ui/client-32","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"workflows.list() / .get(id) / .remove(id)"},"1093":{"id":"/docs/ui/client-33","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"GET /workflows, GET / DELETE /workflows/:id; definitions carry inputKeys"},"1094":{"id":"/docs/ui/client-34","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"workflows.run(id, input?) / .generate(task)"},"1095":{"id":"/docs/ui/client-35","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"POST /workflows/run, /workflows/generate"},"1096":{"id":"/docs/ui/client-36","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"mcp.status() (servers with tools: [{ name }] and url or command + args) / .tools(id) ({ name, description?, inputSchema? }) / .connect(id?) / .disconnect(id) / .reload(id?) / .add(config) / .remove(id) / .completeAuth(id, code)"},"1097":{"id":"/docs/ui/client-37","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"GET /mcp, GET /mcp/:id/tools, POST /mcp/*"},"1098":{"id":"/docs/ui/client-38","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"rag.sources() / .ingest(docs) / .query(q, k?)"},"1099":{"id":"/docs/ui/client-39","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"/rag/* (ingest posts { docs })"},"1100":{"id":"/docs/ui/client-40","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"models.list() / .setDefault(id) / .test(id) / .add(cfg) / .refresh() / .remove(id) / .usage()"},"1101":{"id":"/docs/ui/client-41","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"/models/*"},"1102":{"id":"/docs/ui/client-42","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"Every call checks the response and throws AgentKitError { status, message, body } on failure."},"1103":{"id":"/docs/ui/client-43","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"createSessionHub(url, options?) does that routing for you: one /events/all stream, every event folded into its session's state with the reducers below, so sessions in the background keep updating while the UI shows another."},"1104":{"id":"/docs/ui/client-44","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"Member"},"1105":{"id":"/docs/ui/client-45","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"session(id)"},"1106":{"id":"/docs/ui/client-46","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"A ClientSession for id (the same object per id): every call carries id, on / onAny see that session's events plus agent-wide ones (MCP, models) from the shared stream, send / answer emit client:send / client:answer, workflows.run closes the run in the hub's state when it returns. Pass it to any store or hook. Its close() detaches its listeners only"},"1107":{"id":"/docs/ui/client-47","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"state(id)"},"1108":{"id":"/docs/ui/client-48","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"{ conversation, pending, workflow, plan, todos, usage }; emptySessionState for a session it hasn't seen"},"1109":{"id":"/docs/ui/client-49","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"sessions() / subscribe(fn)"},"1110":{"id":"/docs/ui/client-50","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"Ids it knows (from events, session(), seed(), create()), in order; fn runs after any change"},"1111":{"id":"/docs/ui/client-51","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"seed(id) / create() / forget(id)"},"1112":{"id":"/docs/ui/client-52","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"Load history; start a session; drop one's state"},"1113":{"id":"/docs/ui/client-53","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"status / onStatus(fn) / close()"},"1114":{"id":"/docs/ui/client-54","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"The shared stream"},"1115":{"id":"/docs/ui/client-55","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"options are connect()'s (token, tenant, reconnect) plus conversation (passed to reduceConversation, e.g. { includeNested: true }). The hub loads the saved workflows (GET /workflows) on each (re)connect so a run shows every step up front."},"1116":{"id":"/docs/ui/client-56","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"Pure reducers turn the event stream into the state a UI renders. They are (state, event) => state, so they work in any framework, in tests and in a plain <script type=\"module\">."},"1117":{"id":"/docs/ui/client-57","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"Reducer"},"1118":{"id":"/docs/ui/client-58","p