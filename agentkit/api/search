s/ui/custom-5","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"Third-party AG-UI consumers — same event envelope { type, payload, timestamp }"},"1147":{"id":"/docs/ui/custom-6","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"Design tips:"},"1148":{"id":"/docs/ui/custom-7","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"Treat events as the source of truth; avoid polling /send for partial text."},"1149":{"id":"/docs/ui/custom-8","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"Keep one SSE connection per UI session; multiplex handlers with session.on(type, fn)."},"1150":{"id":"/docs/ui/custom-9","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"Approvals and elicitation are async: listen for approval:request / elicitation:request, then call the matching POST endpoints (or session.approve / answer)."},"1151":{"id":"/docs/ui/custom-10","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"Point UI env vars at your server: NEXT_PUBLIC_AGENT_URL, VITE_AGENT_URL."},"1152":{"id":"/docs/ui/custom-11","page_id":"/docs/ui/custom","tags":[],"type":"text","url":"/docs/ui/custom","content":"See Streaming & wire protocol for the full endpoint and event list."},"1153":{"id":"/docs/ui/react","page_id":"/docs/ui/react","type":"page","content":"React","breadcrumbs":["Documentation","UI"],"tags":[],"url":"/docs/ui/react"},"1154":{"id":"/docs/ui/react-0","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react","content":"@agentkit/react hooks and components"},"1155":{"id":"/docs/ui/react-1","page_id":"/docs/ui/react","type":"heading","tags":[],"url":"/docs/ui/react#hook-useagentsession","content":"Hook: useAgentSession"},"1156":{"id":"/docs/ui/react-2","page_id":"/docs/ui/react","type":"heading","tags":[],"url":"/docs/ui/react#state-hooks","content"