-164","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#createagentconfig","content":"AI-generated DAG workflows (unstable)"},"167":{"id":"/docs/config-reference-165","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#createagentconfig","content":"plugins"},"168":{"id":"/docs/config-reference-166","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#createagentconfig","content":"Plugin[]"},"169":{"id":"/docs/config-reference-167","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#createagentconfig","content":"none"},"170":{"id":"/docs/config-reference-168","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#createagentconfig","content":"Event hooks; optional tools, sources, transformContext; graph plugin for workflows"},"171":{"id":"/docs/config-reference-169","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"Field"},"172":{"id":"/docs/config-reference-170","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"Default"},"173":{"id":"/docs/config-reference-171","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"Description"},"174":{"id":"/docs/config-reference-172","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"toolResultHandles"},"175":{"id":"/docs/config-reference-173","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"true"},"176":{"id":"/docs/config-reference-174","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content