cs/ui/react#hook-useagentsession","content":"Register on() handlers only after ready === true. Unsubscribe in the useEffect cleanup."},"2008":{"id":"/docs/ui/react-9","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"Most UIs don't need on() at all: pass client to a state hook and render what it returns. Each hook wraps a pure reducer from @agentkit/client, so the same logic runs in Vue, Svelte and plain JS."},"2009":{"id":"/docs/ui/react-10","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"Hook"},"2010":{"id":"/docs/ui/react-11","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"Returns"},"2011":{"id":"/docs/ui/react-12","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"useConversation(client, { includeNested? })"},"2012":{"id":"/docs/ui/react-13","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ messages, streaming } — each message has text, thinking?, tools, artifacts, ordered parts, status; workflow-step and subagent events stay out unless includeNested"},"2013":{"id":"/docs/ui/react-14","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"usePendingRequests(client)"},"2014":{"id":"/docs/ui/react-15","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ approvals, questions, approve, reject, answer } — a request disappears when it is settled anywhere (here, another tab, an admin console) or the run ends"},"2015":{"id":"/docs/ui/react-16","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"useWorkflowRun(client)"},"2016":{"id":"/docs/ui/react-17","page_id":"/docs/ui/react","tags":[],"type":"text","url":"/docs/ui/react#state-hooks","content":"{ runs, generating, savePrompt, list, run(id, input?), gen