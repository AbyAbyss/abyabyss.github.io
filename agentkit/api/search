":"/docs/capabilities/coding-agent-24","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"read"},"723":{"id":"/docs/capabilities/coding-agent-25","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"rg when available, else fallback scan"},"724":{"id":"/docs/capabilities/coding-agent-26","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"run_command"},"725":{"id":"/docs/capabilities/coding-agent-27","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"write"},"726":{"id":"/docs/capabilities/coding-agent-28","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"bash -lc in workspace cwd"},"727":{"id":"/docs/capabilities/coding-agent-29","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"Paths are resolved under root; .. escapes are rejected. run_command blocks a small set of dangerous patterns (not a full security sandbox)."},"728":{"id":"/docs/capabilities/coding-agent-30","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"With a scratch workspace, paths that start with scratch/ (or @scratch/) name the scratch folder in every tool, including run_command: after write_file(\"scratch/hello.js\"), both node scratch/hello.js and cd scratch && node hello.js work, whether or not a project folder is attached. run_command also sets $SCRATCH to the folder's absolute path. Commands start in the project root, or in the scratch folder when there is no project."},"729":{"id":"/docs/capabilities/coding-agent-31","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#workspace-tools","content":"A command that exits non-zero comes back with its exit code and output for the model, marked isError: true with the line that explains it (exited with code 1: Error: Cannot find module …), so it shows as a failed call in traces."},"730":{"id":"/docs/capabilities/coding-agent-32","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Store"},"731":{"id":"/docs/capabilities/coding-agent-33","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Config"},"732":{"id":"/docs/capabilities/coding-agent-34","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Purpose"},"733":{"id":"/docs/capabilities/coding-agent-35","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Conversation memory"},"734":{"id":"/docs/capabilities/coding-agent-36","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"memory: { store: 'sqlite', path }"},"735":{"id":"/docs/capabilities/coding-agent-37","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Chat history per session"},"736":{"id":"/docs/capabilities/coding-agent-38","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Tool result cache"},"737":{"id":"/docs/capabilities/coding-agent-39","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"cache: { store: 'sqlite', path: '.agentkit/cache.db' }"},"738":{"id":"/docs/capabilities/coding-agent-40","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Dedupe identical tool calls (TTL on each tool, e.g. cache: '5m')"},"739":{"id":"/docs/capabilities/coding-agent-41","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Durable sessions"},"740":{"id":"/docs/capabilities/coding-agent-42","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"durableSessions: { enabled, path }"},"741":{"id":"/docs/capabilities/coding-agent-43","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"JSON snapshots under .agentkit/sessions/"},"742":{"id":"/docs/capabilities/coding-agent-44","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#tool-cache-vs-memory","content":"Use separate SQLite files so backend cache does not mix with long-term memory."},"743":{"id":"/docs/capabilities/coding-agent-45","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#code-cli","content":"From the repo root:"},"744":{"id":"/docs/capabilities/coding-agent-46","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#code-cli","content":"Flags: --mock, --task, --approve-writes, --mode direct|plan|ask, multiline input with \"\"\"."},"745":{"id":"/docs/capabilities/coding-agent-47","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#code-cli","content":"Future: extract to published @agentkit/cli with agentkit code <dir>."},"746":{"id":"/docs/capabilities/coding-agent-48","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#plugins","content":"Plugins may export tools?: ToolDef[]; they are merged at runtime init alongside developer tools and MCP tools."},"747":{"id":"/docs/capabilities/coding-agent-49","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#related","content":"Tools — Zod tools and TTL cache"},"748":{"id":"/docs/capabilities/coding-agent-50","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#related","content":"Approvals — write/command gates"},"749":{"id":"/docs/capabilities/coding-agent-51","page_id":"/docs/capabilities/coding-agent","tags":[],"type":"text","url":"/docs/capabilities/coding-agent#related","content":"Harness — record/replay (cli-agent example)"},"750":{"id":"/docs/capabilities/context","page_id":"/docs/capabilities/context","type":"page","content":"Context and encoding","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/context"},"751":{"id":"/docs/capabilities/context-0","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context","content":"Adaptive TOON/JSON/CSV encoding and context compaction"},"752":{"id":"/docs/capabilities/context-1","page_id":"/docs/capabilities/context","type":"heading","tags":[],"url":"/docs/capabilities/context#agent-config","content":"Agent config"},"753":{"id":"/docs/capabilities/context-2","page_id":"/docs/capabilities/context","type":"heading","tags":[],"url":"/docs/capabilities/context#standalone-encoding-package","content":"Standalone encoding package"},"754":{"id":"/docs/capabilities/context-3","page_id":"/docs/capabilities/context","type":"heading","tags":[],"url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"Which tools a run sees: tool search"},"755":{"id":"/docs/capabilities/context-4","page_id":"/docs/capabilities/context","type":"heading","tags":[],"url":"/docs/capabilities/context#tool-result-handles","content":"Tool-result handles"},"756":{"id":"/docs/capabilities/context-5","page_id":"/docs/capabilities/context","type":"heading","tags":[],"url":"/docs/capabilities/context#related","content":"Related"},"757":{"id":"/docs/capabilities/context-6","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context","content":"Large structured payloads (especially uniform object arrays from MCP resources) are passed through @agentkit/encoding before they enter the model context. The encoder picks the smallest representation (TOON, compact JSON, or CSV) by estimated token count."},"758":{"id":"/docs/capabilities/context-7","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context","content":"Configure compaction when conversation history grows: maybeCompactContext drops older turns into a short summary when estimated tokens exceed compactAt × maxTokens."},"759":{"id":"/docs/capabilities/context-8","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#standalone-encoding-package","content":"Use @agentkit/encoding outside the agent for benchmarks or custom pipelines:"},"760":{"id":"/docs/capabilities/context-9","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"Sending every tool definition on every model call stops working once an agent has a few MCP\nservers: five servers can be ~55k tokens before the model reads your message, and models pick\nthe wrong tool more often past 30–50 tools. Tool search is on by default and turns itself on\nwhen a run has more than 30 tools or about 10k tokens of tool definitions. Below that,\nnothing changes."},"761":{"id":"/docs/capabilities/context-10","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"When it is on, each model call gets:"},"762":{"id":"/docs/capabilities/context-11","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"The likely tools: the best keyword matches between the task and each tool's name,\nargument names and description (6 by default), plus anything in alwaysLoad and any tool the\nrun or session allows by name (tools.allow)."},"763":{"id":"/docs/capabilities/context-12","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"A catalogue in the system prompt: one line per MCP server or category, with a count and\nexample names, so the model knows what exists:\n- github (40): list_issues, create_pull_request, …"},"764":{"id":"/docs/capabilities/context-13","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"A search_tools tool: the model asks for what it needs (\"post to slack\", \"github\") and\nthe best matches become callable on its next step, with their full definitions."},"765":{"id":"/docs/capabilities/context-14","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"Tools found in a session stay loaded for the rest of it. A tool the model calls by its exact\nname still runs, even if it was not offered. It works with every provider: the search runs\nin AgentKit, not in a provider API."},"766":{"id":"/docs/capabilities/context-15","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"On a live run with 80 tools across 8 servers (\"Let the team know in #eng that the deploy\nfinished\"), Claude Haiku 4.5 and GPT-4.1 mini each searched once, found slack__post_message\nand called it; input tokens for the turn dropped from 14,357 to 4,598 and from 5,398 to 1,995."},"767":{"id":"/docs/capabilities/context-16","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"In traces, each llm.stream span records toolsOffered and toolsDeferred, and each search\nis an ordinary search_tools tool span."},"768":{"id":"/docs/capabilities/context-17","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"With tool search off (toolSearch: false, or \"auto\" below the thresholds), up to\ncontext.maxTools MCP tools (default 64) go to the model as they are, and past that they are\nranked by keyword match with the task. Tools the run or session allows by name, and every tool\nof a server connected at runtime (agent.mcp.connect, POST /mcp/add), always stay."},"769":{"id":"/docs/capabilities/context-18","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#which-tools-a-run-sees-tool-search","content":"The plugin kernel has the same behaviour through deferredTools; see\nContext engineering."},"770":{"id":"/docs/capabilities/context-19","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#tool-result-handles","content":"Large tool outputs are stored in an in-run handle store. The model sees a compact { handle, summary } and can call the built-in expand_tool_result tool to fetch the full payload. Handles are per-run (not persisted across sessions)."},"771":{"id":"/docs/capabilities/context-20","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#related","content":"Sources — encoded resource snapshots"},"772":{"id":"/docs/capabilities/context-21","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#related","content":"Configuration reference"},"773":{"id":"/docs/capabilities/context-22","page_id":"/docs/capabilities/context","tags":[],"type":"text","url":"/docs/capabilities/context#related","content":"packages/encoding — encodeAdaptive implementation"},"774":{"id":"/docs/capabilities/harness","page_id":"/docs/capabilities/harness","type":"page","content":"Harness","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/harness"},"775":{"id":"/docs/capabilities/harness-0","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness","content":"Record agent event streams and replay on another model"},"776":{"id":"/docs/capabilities/harness-1","page_id":"/docs/capabilities/harness","type":"heading","tags":[],"url":"/docs/capabilities/harness#record-a-session","content":"Record a session"},"777":{"id":"/docs/capabilities/harness-2","page_id":"/docs/capabilities/harness","type":"heading","tags":[],"url":"/docs/capabilities/harness#replay","content":"Replay"},"778":{"id":"/docs/capabilities/harness-3","page_id":"/docs/capabilities/harness","type":"heading","tags":[],"url":"/docs/capabilities/harness#cli-replay-agentkit-replay","content":"CLI replay (agentkit-replay)"},"779":{"id":"/docs/capabilities/harness-4","page_id":"/docs/capabilities/harness","type":"heading","tags":[],"url":"/docs/capabilities/harness#recording-shape","content":"Recording shape"},"780":{"id":"/docs/capabilities/harness-5","page_id":"/docs/capabilities/harness","type":"heading","tags":[],"url":"/docs/capabilities/harness#related","content":"Related"},"781":{"id":"/docs/capabilities/harness-6","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness","content":"Harness records AG-UI events during agent.run() into JSON session files, then replays them against a different provider/model for regression checks (“did we get the same tool sequence and outcome?”)."},"782":{"id":"/docs/capabilities/harness-7","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness","content":"Use harness in CI or local CLI workflows — not for production user traffic. Pair with Logging (cost:update is included in recordings)."},"783":{"id":"/docs/capabilities/harness-8","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#record-a-session","content":"harness.record alone also enables recording (see create-agent.ts). Showcase uses .agentkit/showcase-harness.jsonl in the full demo config."},"784":{"id":"/docs/capabilities/harness-9","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#replay","content":"Vitest: packages/core/src/phase3.test.ts (harness recording replays on a different model)."},"785":{"id":"/docs/capabilities/harness-10","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#cli-replay-agentkit-replay","content":"The @agentkit/core package ships a replay binary — no custom script required:"},"786":{"id":"/docs/capabilities/harness-11","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#cli-replay-agentkit-replay","content":"examples/cli-agent wraps record + the same replay API:"},"787":{"id":"/docs/capabilities/harness-12","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#cli-replay-agentkit-replay","content":"Source: packages/core/bin/replay.mjs, examples/cli-agent/src/cli.ts (harness: { enabled: true, record: \"./sessions\" })."},"788":{"id":"/docs/capabilities/harness-13","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#recording-shape","content":"HarnessRecording (version 1) includes task, provider, model, events[], output, and recordedAt. Unsupported versions throw from loadHarnessRecording."},"789":{"id":"/docs/capabilities/harness-14","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#related","content":"Providers — swap model on replay"},"790":{"id":"/docs/capabilities/harness-15","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#related","content":"Orchestration — parallel runs emit agent:spawned into recordings"},"791":{"id":"/docs/capabilities/harness-16","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#related","content":"Configuration reference — harness table"},"792":{"id":"/docs/capabilities/harness-17","page_id":"/docs/capabilities/harness","tags":[],"type":"text","url":"/docs/capabilities/harness#related","content":"showcase /full — harness enabled in gallery agent config"},"793":{"id":"/docs/capabilities/logging","page_id":"/docs/capabilities/logging","type":"page","content":"Logging and observability","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/logging"},"794":{"id":"/docs/capabilities/logging-0","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging","content":"Structured log events and token cost meter"},"795":{"id":"/docs/capabilities/logging-1","page_id":"/docs/capabilities/logging","type":"heading","tags":[],"url":"/docs/capabilities/logging#config","content":"Config"},"796":{"id":"/docs/capabilities/logging-2","page_id":"/docs/capabilities/logging","type":"heading","tags":[],"url":"/docs/capabilities/logging#wire-client","content":"Wire client"},"797":{"id":"/docs/capabilities/logging-3","page_id":"/docs/capabilities/logging","type":"heading","tags":[],"url":"/docs/capabilities/logging#opentelemetry-spans","content":"OpenTelemetry spans"},"798":{"id":"/docs/capabilities/logging-4","page_id":"/docs/capabilities/logging","type":"heading","tags":[],"url":"/docs/capabilities/logging#related","content":"Related"},"799":{"id":"/docs/capabilities/logging-5","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging","content":"AgentKit surfaces runtime activity as typed AG-UI events rather than only stdout. Set logging.level to control log emissions from the agent shell, and subscribe to cost:update for per-turn token and cost estimates from the active provider."},"800":{"id":"/docs/capabilities/logging-6","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging","content":"Use this for activity feeds in custom UIs, debug panels in development, and billing meters — not as a replacement for your host app's production log aggregator yet."},"801":{"id":"/docs/capabilities/logging-7","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#config","content":"The reasoning loop also emits log at info level for tool starts (see orchestrator/loop.ts). Sessions emit log on cancel."},"802":{"id":"/docs/capabilities/logging-8","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"All events stream over SSE — see Streaming. No separate logging HTTP API."},"803":{"id":"/docs/capabilities/logging-9","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"Event"},"804":{"id":"/docs/capabilities/logging-10","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"Payload (summary)"},"805":{"id":"/docs/capabilities/logging-11","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"log"},"806":{"id":"/docs/capabilities/logging-12","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"{ level, message }"},"807":{"id":"/docs/capabilities/logging-13","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"cost:update"},"808":{"id":"/docs/capabilities/logging-14","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"{ model, inputTokens, outputTokens, cost, ... }"},"809":{"id":"/docs/capabilities/logging-15","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"tool:call / tool:result"},"810":{"id":"/docs/capabilities/logging-16","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"Tool tracing"},"811":{"id":"/docs/capabilities/logging-17","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"error / done"},"812":{"id":"/docs/capabilities/logging-18","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#wire-client","content":"Turn outcome"},"813":{"id":"/docs/capabilities/logging-19","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#opentelemetry-spans","content":"Set logging.otel: true to emit JSON span records from the reasoning loop (agent.run, agent.step, agent.tool). This is a lightweight file-friendly format, not a full OTel exporter SDK. Pair with cost:update and log events for custom dashboards."},"814":{"id":"/docs/capabilities/logging-20","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#related","content":"Providers — agent.models.usage() aggregates by model"},"815":{"id":"/docs/capabilities/logging-21","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#related","content":"Harness — record cost:update in session JSON"},"816":{"id":"/docs/capabilities/logging-22","page_id":"/docs/capabilities/logging","tags":[],"type":"text","url":"/docs/capabilities/logging#related","content":"showcase /full — cost meter in the gallery footer"},"817":{"id":"/docs/capabilities/mcp","page_id":"/docs/capabilities/mcp","type":"page","content":"MCP","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/mcp"},"818":{"id":"/docs/capabilities/mcp-0","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp","content":"Model Context Protocol client transports and agent-as-server mode"},"819":{"id":"/docs/capabilities/mcp-1","page_id":"/docs/capabilities/mcp","type":"heading","tags":[],"url":"/docs/capabilities/mcp#transports","content":"Transports"},"820":{"id":"/docs/capabilities/mcp-2","page_id":"/docs/capabilities/mcp","type":"heading","tags":[],"url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"OAuth (GitHub and other signed-in servers)"},"821":{"id":"/docs/capabilities/mcp-3","page_id":"/docs/capabilities/mcp","type":"heading","tags":[],"url":"/docs/capabilities/mcp#runtime-api-agentmcp","content":"Runtime API (agent.mcp)"},"822":{"id":"/docs/capabilities/mcp-4","page_id":"/docs/capabilities/mcp","type":"heading","tags":[],"url":"/docs/capabilities/mcp#expose-agent-as-mcp-server","content":"Expose agent as MCP server"},"823":{"id":"/docs/capabilities/mcp-5","page_id":"/docs/capabilities/mcp","type":"heading","tags":[],"url":"/docs/capabilities/mcp#wire--ui","content":"Wire + UI"},"824":{"id":"/docs/capabilities/mcp-6","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp","content":"AgentKit connects to external MCP servers at agent startup and merges their capabilities with your own Zod tools. MCP resources and source-classified tools feed read-only context; callable tools are namespaced as serverId__toolName and run through the same approval and reasoning loop as developer tools."},"825":{"id":"/docs/capabilities/mcp-7","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp","content":"Use MCP when you want filesystem, GitHub, or other protocol servers without writing custom tool wrappers. Use transport: \"mock\" for tests and the showcase gallery without subprocesses."},"826":{"id":"/docs/capabilities/mcp-8","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"Transport"},"827":{"id":"/docs/capabilities/mcp-9","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"Config"},"828":{"id":"/docs/capabilities/mcp-10","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"When to use"},"829":{"id":"/docs/capabilities/mcp-11","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"mock"},"830":{"id":"/docs/capabilities/mcp-12","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"mock: { tools?, resources? }"},"831":{"id":"/docs/capabilities/mcp-13","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"Demos, Vitest, offline CI"},"832":{"id":"/docs/capabilities/mcp-14","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"stdio"},"833":{"id":"/docs/capabilities/mcp-15","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"command, args?"},"834":{"id":"/docs/capabilities/mcp-16","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"Local MCP binaries (filesystem, Cursor-style)"},"835":{"id":"/docs/capabilities/mcp-17","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"http"},"836":{"id":"/docs/capabilities/mcp-18","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"url, headers?"},"837":{"id":"/docs/capabilities/mcp-19","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"Remote / streamable-HTTP servers; headers carries auth"},"838":{"id":"/docs/capabilities/mcp-20","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"There is no separate \"streamableHttp\" transport — transport: \"http\" is the streamable-HTTP client. It speaks JSON-RPC 2.0 over POST {url} (initialize → tools/list → tools/call) and falls back to GET {url}/tools for servers that only expose a REST listing. Any headers you supply are sent on every request, so use them for Authorization, API_KEY, API_SECRET, etc."},"839":{"id":"/docs/capabilities/mcp-21","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#transports","content":"On connect, the runtime emits mcp:servers:changed, mcp:tools:loaded, and sources:changed (after resources are TOON-encoded). Tool calls emit mcp:tool:call / mcp:tool:result."},"840":{"id":"/docs/capabilities/mcp-22","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"An http server that answers 401 starts the MCP authorization flow: discovery, client registration, PKCE sign-in, token refresh. Tokens persist under .agentkit/mcp-auth/, so a server signs in once."},"841":{"id":"/docs/capabilities/mcp-23","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"Some servers, GitHub's among them, don't let clients register themselves. Give those a pre-registered OAuth app:"},"842":{"id":"/docs/capabilities/mcp-24","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"Create the app at GitHub → Settings → Developer settings → OAuth Apps. Its callback URL is where the sign-in lands:"},"843":{"id":"/docs/capabilities/mcp-25","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"CLI or script (createAgent alone): a loopback port AgentKit opens; register http://127.0.0.1/callback (GitHub accepts any port on a loopback callback)."},"844":{"id":"/docs/capabilities/mcp-26","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"Behind serve() (servers added with POST /mcp/add or listed in mcpServers): the agent server itself, at /mcp/oauth/callback/<server id>, e.g. http://127.0.0.1:8795/mcp/oauth/callback/github. The server lists as unauthorized with an authorizationUrl; open it, sign in, and the callback finishes the flow. /mcp/add takes the same auth (clientId, clientSecret, scopes); the secret stays on the server and never comes back in GET /mcp."},"845":{"id":"/docs/capabilities/mcp-27","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#oauth-github-and-other-signed-in-servers","content":"No OAuth app? A personal access token works as a header: headers: { Authorization: \"Bearer <token>\" }."},"846":{"id":"/docs/capabilities/mcp-28","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#runtime-api-agentmcp","content":"When mcp is not false, the agent exposes a manager (also used internally at init):"},"847":{"id":"/docs/capabilities/mcp-29","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#runtime-api-agentmcp","content":"agent.mcp.tools() returns { name, serverId, description?, jsonSchema? } for each callable tool. Stdio servers take env: { KEY: \"value\" }, merged over the parent's environment. Leave a whole server out of one run with send(input, { tools: { deny: [\"<serverId>__*\"] } })."},"848":{"id":"/docs/capabilities/mcp-30","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#runtime-api-agentmcp","content":"Every MCP tool reaches the model as a tool, whatever its name. To use one as read-only context instead, mark it kind: \"source\" on the mock tool or classify: { toolName: \"source\" } on the server config — see Sources."},"849":{"id":"/docs/capabilities/mcp-31","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#expose-agent-as-mcp-server","content":"Other clients (e.g. Claude Desktop) can call your agent via a minimal JSON-RPC HTTP server:"},"850":{"id":"/docs/capabilities/mcp-32","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"Browser apps use @agentkit/server + @agentkit/client; MCP stays on the agent process. See Streaming & wire protocol and examples/express-api (mock MCP + approvals)."},"851":{"id":"/docs/capabilities/mcp-33","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"Example"},"852":{"id":"/docs/capabilities/mcp-34","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"Focus"},"853":{"id":"/docs/capabilities/mcp-35","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"express-api"},"854":{"id":"/docs/capabilities/mcp-36","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"Mock MCP + gated tool"},"855":{"id":"/docs/capabilities/mcp-37","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"showcase /mcp"},"856":{"id":"/docs/capabilities/mcp-38","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"Interactive MCP demo"},"857":{"id":"/docs/capabilities/mcp-39","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"pnpm example:express"},"858":{"id":"/docs/capabilities/mcp-40","page_id":"/docs/capabilities/mcp","tags":[],"type":"text","url":"/docs/capabilities/mcp#wire--ui","content":"Full UI + agent"},"859":{"id":"/docs/capabilities/memory","page_id":"/docs/capabilities/memory","type":"page","content":"Memory","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/memory"},"860":{"id":"/docs/capabilities/memory-0","page_id":"/docs/capabilities/memory","tags":[],"type":"text","url":"/docs/capabilities/memory","content":"Conversation history and durable recall across turns"},"861":{"id":"/docs/capabilities/memory-1","page_id":"/docs/capabilities/memory","type":"heading","tags":[],"url":"/docs/capabilities/memory#config","content":"Config"},"862":{"id":"/docs/capabilities/memory-2","page_id":"/docs/capabilities/memory","type":"heading","tags":[],"url":"/docs/capabilities/memory#store-options","content":"Store options"},"863":{"id":"/docs/capabilities/memory-3","page_id":"/docs/capabilities/memory","type":"heading","tags":[],"url":"/docs/capabilities/memory#ttl-and-extract","content":"TTL and extract"},"864":{"id":"/docs/capabilities/memory-4","page_id":"/docs/capabilities/memory","type":"heading","tags":[],"url":"/docs/capabilities/memory#events-and-scoping","content":"Events and scoping"},"865":{"id":"/docs/capabilities/memory-5","page_id":"/docs/capabilities/memory","type":"heading","tags":[],"url":"/docs/capabilities/memory#related","content":"Related"},"866":{"id":"/docs/capabilities/memory-6","page_id":"/docs/capabilities/memory","tags":[],"type":"text","url":"/docs/capabilities/memory","content":"Memory stores prior user/assistant turns per namespace (session, optional userId / orgId from tenant or agent.session({ userId })). The reasoning loop appends to the store and queries recen