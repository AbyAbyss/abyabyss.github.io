285","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"ProviderConfigInput | Provider"},"288":{"id":"/docs/config-reference-286","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"Defaults to the team's defaultProvider"},"289":{"id":"/docs/config-reference-287","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"handoffs"},"290":{"id":"/docs/config-reference-288","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"string[]"},"291":{"id":"/docs/config-reference-289","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"Agents this one may transfer to (default: all others)"},"292":{"id":"/docs/config-reference-290","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"maxSteps"},"293":{"id":"/docs/config-reference-291","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"number"},"294":{"id":"/docs/config-reference-292","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"Reasoning-loop step budget (default 8)"},"295":{"id":"/docs/config-reference-293","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#multi-agent-handoffs-createhandoffteam","content":"createHandoffTeam({ agents, entry?, defaultProvider?, bus?, maxHandoffs? }) returns { run, on, bus, agents, entry }. run(task) resolves { output, finalAgent, path, handoffs, usage }. Routing loops are bounded by maxHandoffs (default 8)."},"296":{"id":"/docs/config-reference-294","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#evaluating-agents-evaluate-scorers","content":"evaluate(target, cases, opts?) runs a suite through an agent and returns a pass/fail EvalReport — test agent behaviour like any other code."},"297":{"id":"/docs/config-reference-295","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#evaluating-agents-evaluate-scorers","content":"target is a single Agent (reused) or a factory () => Agent (fresh, auto-closed per case). opts.concurrency runs cases in parallel. A failing scorer or a thrown run is recorded as a failed case — the suite never crashes."},"298":{"id":"/docs/config-reference-296","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#evaluating-agents-evaluate-scorers","content":"Built-in scorers: contains, matches, equals, toolCalled, toolNotCalled, noToolErrors, maxCost, maxToolCalls, custom. A per-case output zod schema scores structured results with equals."},"299":{"id":"/docs/config-reference-297","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"stream:start, stream:token, stream:end"},"300":{"id":"/docs/config-reference-298","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"thinking:start, thinking:delta, thinking:end"},"301":{"id":"/docs/config-reference-299","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"tool:call, tool:result, tool:error"},"302":{"id":"/docs/config-reference-300","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"mcp:servers:changed, mcp:tools:loaded, mcp:tool:call, mcp:tool:result, mcp:auth:required, mcp:auth:completed"},"303":{"id":"/docs/config-reference-301",