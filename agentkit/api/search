sion-points","content":"waterfall"},"2177":{"id":"/docs/extend/runtime-61","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"wrap dispatch: deadlines, retries, metrics"},"2178":{"id":"/docs/extend/runtime-62","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"tools/post-execute"},"2179":{"id":"/docs/extend/runtime-63","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"waterfall"},"2180":{"id":"/docs/extend/runtime-64","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"transform the result"},"2181":{"id":"/docs/extend/runtime-65","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"tools/result"},"2182":{"id":"/docs/extend/runtime-66","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"emit"},"2183":{"id":"/docs/extend/runtime-67","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"observe the immutable outcome"},"2184":{"id":"/docs/extend/runtime-68","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"tools/ask"},"2185":{"id":"/docs/extend/runtime-69","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"serial"},"2186":{"id":"/docs/extend/runtime-70","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"answer a permission question"},"2187":{"id":"/docs/extend/runtime-71","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"fs/access"},"2188":{"id":"/docs/extend/runtime-72","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"waterfall"},"2189":{"id":"/docs/extend/runtime-73","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"confine paths, or go read-only"},"2190":{"id":"/docs/extend/runtime-74","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"subprocess/spawn"},"2191":{"id":"/docs/extend/runtime-75","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"waterfall"},"2192":{"id":"/docs/extend/runtime-76","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"vet or rewrite a command"},"2193":{"id":"/docs/extend/runtime-77","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"session/event"},"2194":{"id":"/docs/extend/runtime-78","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"emit"},"2195":{"id":"/docs/extend/runtime-79","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"render a UI, ship telemetry, persist"},"2196":{"id":"/docs/extend/runtime-80","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#extension-points","content":"Plus ctx.tools.guard() for a monotonic deny no listener can talk past, and ctx.tools.restrict() for a visible set that presentation, lookup, and execution all read through."},"2197":{"id":"/docs/extend/runtime-81","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#a-policy-plugin-end-to-end","content":"A decision is { kind: \"allow\" }, { kind: \"deny\", reason }, or { kind: \"ask\", question }. The runtime — not your plugin — runs the tools/ask serial when a listener answers ask, so asking and answering stay independently replaceable."},"2198":{"id":"/docs/extend/runtime-82","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#a-policy-plugin-end-to-end","content":"The difference between the two mechanisms matters. A tools/pre-execute listener is policy — reorderable, overridable, and the right home for \"ask the user\". A guard is an invariant — it only ever adds refusals, and a derived registry inherits it, so moving into a realm cannot escape it."},"2199":{"id":"/docs/extend/runtime-83","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#a-policy-plugin-end-to-end","content":"exec carries name, frozen arguments, sessionId, an AbortSignal, and inject(content) for pushing model-visible context into the next request."},"2200":{"id":"/docs/extend/runtime-84","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#prompt-assembly","content":"Sections are ordered and independently owned, so two plugins can each contribute context without knowing about each other:"},"2201":{"id":"/docs/extend/runtime-85","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#prompt-assembly","content":"Lower order runs first, and the convention leaves gaps: 10 identity, 20 policy, 40 context, 80 skills. The id is stable, so a later plugin can shadow a section by reusing it. ctx.systemPrompt.list() shows what would render, in order."},"2202":{"id":"/docs/extend/runtime-86","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#prompt-assembly","content":"system-prompt/assemble is the waterfall around the finished prompt, for anyone who needs the last word."},"2203":{"id":"/docs/extend/runtime-87","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#replacing-the-loop","content":"Everything else — tools, prompt, log, agents — keeps working, because none of them call the loop; the loop calls them."},"2204":{"id":"/docs/extend/runtime-88","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#optional-plugins","content":"agentRuntime() deliberately mounts only the spine. These ship alongside it and are opt-in, because each one is a policy choice rather than a default:"},"2205":{"id":"/docs/extend/runtime-89","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#optional-plugins","content":"budget enforces cost, token, tool-call, step, and duration ceilings per session. It is pure bookkeeping over session/event plus two refusals — agent/pre-step for the next step, tools/pre-execute for a call inside a step already underway — so nothing in the loop knows a budget exists. A breach refuses the next step rather than aborting mid-flight, so the log ends on a clean turn boundary."},"2206":{"id":"/docs/extend/runtime-90","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#optional-plugins","content":"structuredOutput requires a session's final answer to match a schema:"},"2207":{"id":"/docs/extend/runtime-91","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#optional-plugins","content":"It adds the requirement to the prompt, validates on agent/turn-stopping, feeds a failed parse back as one more step, and appends the accepted value as a durable structured/output event. A fenced block or surrounding prose is tolerated; anything past the attempt limit is logged as an error rather than looped on."},"2208":{"id":"/docs/extend/runtime-92","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#optional-plugins","content":"Subagents are three separate plugins on purpose: subagentsPlugin is the registry, inProcessSubagents is one provider, and subagentTool is the model-facing task tool. Swapping the provider for a forked process or a remote runtime changes nothing else. A definition with tools gets its own realm via ctx.isolate(\"tools\"), so a restricted subagent genuinely cannot reach the parent's other tools, and its identity is a scoped prompt section rather than a user message it could be argued out of."},"2209":{"id":"/docs/extend/runtime-93","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#persistence","content":"@agentkit/runtime ships only MemorySessionStore so it stays edge-capable. The Node-side implementations of the same seam live in @agentkit/core:"},"2210":{"id":"/docs/extend/runtime-94","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#persistence","content":"Scoped like any other registration: unloading the plugin puts the in-memory store back rather than leaving the runtime pointed at a closed handle."},"2211":{"id":"/docs/extend/runtime-95","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#next","content":"Session log — the projection rule everything else rests on"},"2212":{"id":"/docs/extend/runtime-96","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#next","content":"Tool contract — one definition, four consumers"},"2213":{"id":"/docs/extend/runtime-97","page_id":"/docs/extend/runtime","tags":[],"type":"text","url":"/docs/extend/runtime#next","content":"Execution seams — where file and process access actually happens"},"2214":{"id":"/docs/extend/sessions","page_id":"/docs/extend/sessions","type":"page","content":"Session log","breadcrumbs":["Documentation","Extending"],"tags":[],"url":"/docs/extend/sessions"},"2215":{"id":"/docs/extend/sessions-0","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions","content":"Model-visible means logged — one mechanism instead of five features"},"2216":{"id":"/docs/extend/sessions-1","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#the-invariant","content":"The invariant"},"2217":{"id":"/docs/extend/sessions-2","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#adding-a-durable-fact","content":"Adding a durable fact"},"2218":{"id":"/docs/extend/sessions-3","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#compaction-without-mutation","content":"Compaction, without mutation"},"2219":{"id":"/docs/extend/sessions-4","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#fork-resume-replay","content":"Fork, resume, replay"},"2220":{"id":"/docs/extend/sessions-5","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#watching-the-log","content":"Watching the log"},"2221":{"id":"/docs/extend/sessions-6","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#swapping-the-store","content":"Swapping the store"},"2222":{"id":"/docs/extend/sessions-7","page_id":"/docs/extend/sessions","type":"heading","tags":[],"url":"/docs/extend/sessions#next","content":"Next"},"2223":{"id":"/docs/extend/sessions-8","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions","content":"The session log is an append-only event log, and model history is a projection of it. That is the whole design, and everything else on this page follows from it."},"2224":{"id":"/docs/extend/sessions-9","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions","content":"deriveMessages() builds the model's view of the conversation from the log, and it is the only supported way to build it. That single rule is what makes fork, resume, replay, durable UI, and telemetry fall out of one mechanism instead of being five separate features."},"2225":{"id":"/docs/extend/sessions-10","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#the-invariant","content":"Anything that reaches a model request must be reconstructable from the log."},"2226":{"id":"/docs/extend/sessions-11","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#the-invariant","content":"If a plugin sneaks context into a request without logging it, the session can no longer be forked, resumed, or replayed faithfully — and the bug does not show up until someone tries. So the rule is enforced at the seam: the loop derives history from the log, and nowhere else."},"2227":{"id":"/docs/extend/sessions-12","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#adding-a-durable-fact","content":"A plugin that needs durable state extends the event map and says how the model should see it:"},"2228":{"id":"/docs/extend/sessions-13","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#adding-a-durable-fact","content":"Register no projector and the fact is still durable, still visible to the UI and to telemetry, and simply stays out of the prompt. That is the normal case for metrics and UI state."},"2229":{"id":"/docs/extend/sessions-14","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#adding-a-durable-fact","content":"SessionEvent is a discriminated union, so switch (event.type) narrows event.data with no casts."},"2230":{"id":"/docs/extend/sessions-15","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#compaction-without-mutation","content":"Compaction works the same way: it appends a context/compacted boundary rather than rewriting history. The projection stays a pure function of the log, so the original events are still there for audit, and a fork taken before the boundary still replays the full conversation."},"2231":{"id":"/docs/extend/sessions-16","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#compaction-without-mutation","content":"deriveMessages collapses everything up to the boundary into a single summary turn, so the model sees the compacted view while the log keeps the originals."},"2232":{"id":"/docs/extend/sessions-17","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#fork-resume-replay","content":"Resume is not a feature — it is what happens when a persistent store is mounted and the log is read back. Sequence numbers hydrate from the store on the first append, so a resumed session continues its numbering rather than overwriting history."},"2233":{"id":"/docs/extend/sessions-18","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#watching-the-log","content":"session/event is emitted for every append. A UI, a telemetry exporter, and a persistence layer are all the same kind of subscriber:"},"2234":{"id":"/docs/extend/sessions-19","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#watching-the-log","content":"This is why the transcript UI in mini-harness imports no tool, and gets new tools' cards for free."},"2235":{"id":"/docs/extend/sessions-20","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#swapping-the-store","content":"useStore is scoped like any other registration, so unloading the persistence plugin puts the in-memory store back rather than leaving the runtime pointed at a closed handle:"},"2236":{"id":"/docs/extend/sessions-21","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#swapping-the-store","content":"kind is \"sqlite\", \"jsonl\", or \"custom\" with your own SessionStore — four methods: append, read, list, drop. @agentkit/runtime alone ships MemorySessionStore so it stays edge-capable."},"2237":{"id":"/docs/extend/sessions-22","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#next","content":"Tool contract — what a tool/result event carries, and why"},"2238":{"id":"/docs/extend/sessions-23","page_id":"/docs/extend/sessions","tags":[],"type":"text","url":"/docs/extend/sessions#next","content":"Agent runtime — where the log sits in a turn"},"2239":{"id":"/docs/extend/tools","page_id":"/docs/extend/tools","type":"page","content":"Tool contract","breadcrumbs":["Documentation","Extending"],"tags":[],"url":"/docs/extend/tools"},"2240":{"id":"/docs/extend/tools-0","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools","content":"One definition, four consumers — arguments, canonical value, model prose, and a UI card"},"2241":{"id":"/docs/extend/tools-1","page_id":"/docs/extend/tools","type":"heading","tags":[],"url":"/docs/extend/tools#registration","content":"Registration"},"2242":{"id":"/docs/extend/tools-2","page_id":"/docs/extend/tools","type":"heading","tags":[],"url":"/docs/extend/tools#execution-pipeline","content":"Execution pipeline"},"2243":{"id":"/docs/extend/tools-3","page_id":"/docs/extend/tools","type":"heading","tags":[],"url":"/docs/extend/tools#visibility","content":"Visibility"},"2244":{"id":"/docs/extend/tools-4","page_id":"/docs/extend/tools","type":"heading","tags":[],"url":"/docs/extend/tools#cards","content":"Cards"},"2245":{"id":"/docs/extend/tools-5","page_id":"/docs/extend/tools","type":"heading","tags":[],"url":"/docs/extend/tools#the-exec-handle","content":"The exec handle"},"2246":{"id":"/docs/extend/tools-6","page_id":"/docs/extend/tools","type":"heading","tags":[],"url":"/docs/extend/tools#next","content":"Next"},"2247":{"id":"/docs/extend/tools-7","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools","content":"A tool has four audiences and they want different things. The runtime validates arguments, code consumes a canonical value, the model reads prose, and a UI renders a card. Collapsing those into one string is what makes tool output either unusable by code or unreadable by the model."},"2248":{"id":"/docs/extend/tools-8","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools","content":"defineHarnessTool keeps them separate in one definition. (It is exported under that name from @agentkit/core so it does not collide with the simpler defineTool used by createAgent; both run on the same pipeline.)"},"2249":{"id":"/docs/extend/tools-9","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools","content":"input is validated before execute runs, so args is typed inside with no guard clauses. Without an output.render the value is stringified — fine for simple tools, lossy for everything else."},"2250":{"id":"/docs/extend/tools-10","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools","content":"A value that describes a failure — a command's non-zero exit — can still be returned rather than thrown: output.isError(args, value) marks the result isError while the model reads the rendered value as usual. bashTool does this for a non-zero exit, so the session log, UIs, workflows and Code Mode see the command fail."},"2251":{"id":"/docs/extend/tools-11","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#registration","content":"Registration is effect-scoped: a tool belongs to the plugin that registered it and disappears when that plugin unloads. There is no global tool table to clean up."},"2252":{"id":"/docs/extend/tools-12","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#registration","content":"A tool that already publishes its own model-facing schema — an MCP server, for instance — passes it as jsonSchema and owns its own validation, rather than having one derived from a placeholder Zod type."},"2253":{"id":"/docs/extend/tools-13","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#execution-pipeline","content":"Every call runs through four extension points, in order:"},"2254":{"id":"/docs/extend/tools-14","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#execution-pipeline","content":"guard() — a monotonic deny no later listener can undo. Invariants."},"2255":{"id":"/docs/extend/tools-15","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#execution-pipeline","content":"tools/pre-execute — the reorderable allow / deny / ask policy layer."},"2256":{"id":"/docs/extend/tools-16","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#execution-pipeline","content":"tools/execute — wraps the dispatch itself: deadlines, retries, metrics."},"2257":{"id":"/docs/extend/tools-17","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#execution-pipeline","content":"tools/post-execute — transforms the result; tools/result observes it."},"2258":{"id":"/docs/extend/tools-18","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#execution-pipeline","content":"Execution never throws. A guard that throws, a policy listener that throws, an approval answerer that throws, and execute itself throwing all become an error ToolResult — because a tool failure is a conversation the model can recover from, and an exception out of the pipeline would take the whole turn with it."},"2259":{"id":"/docs/extend/tools-19","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#visibility","content":"Presentation, lookup, and execution all read through the filter, so a hidden tool cannot be called by name either. That is what makes a read-only plan mode real rather than advisory."},"2260":{"id":"/docs/extend/tools-20","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#visibility","content":"Filters are owned by the registry that declares them; guards are inherited from the parent. So a realm can narrow a subagent's tool set without narrowing anyone else's, and still cannot escape the parent's invariants."},"2261":{"id":"/docs/extend/tools-21","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"presentCall and presentResult return a render intent, not markup."},"2262":{"id":"/docs/extend/tools-22","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"A pending call renders as generic, terminal, or diff. A completed call adds search and web:"},"2263":{"id":"/docs/extend/tools-23","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"card"},"2264":{"id":"/docs/extend/tools-24","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"completed shape"},"2265":{"id":"/docs/extend/tools-25","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"generic"},"2266":{"id":"/docs/extend/tools-26","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"title?, content?"},"2267":{"id":"/docs/extend/tools-27","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"terminal"},"2268":{"id":"/docs/extend/tools-28","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"output, exitCode?"},"2269":{"id":"/docs/extend/tools-29","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"diff"},"2270":{"id":"/docs/extend/tools-30","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"diffs: { path, oldText, newText }[]"},"2271":{"id":"/docs/extend/tools-31","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"search"},"2272":{"id":"/docs/extend/tools-32","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"shape: \"matches\" | \"paths\", results, total?, truncated?"},"2273":{"id":"/docs/extend/tools-33","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"web"},"2274":{"id":"/docs/extend/tools-34","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"kind: \"search\" | \"fetch\", sources?, summary?"},"2275":{"id":"/docs/extend/tools-35","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"The tool never imports a UI type; a host maps each card into its own views. @agentkit/react ships a default mapping."},"2276":{"id":"/docs/extend/tools-36","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#cards","content":"Presenters are pure — no I/O, no clock, no session reads — because they run on live streaming and on replay from meta persisted on the tool/result event. A presenter that throws yields no card rather than crashing the replay."},"2277":{"id":"/docs/extend/tools-37","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"field"},"2278":{"id":"/docs/extend/tools-38","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"is"},"2279":{"id":"/docs/extend/tools-39","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"name"},"2280":{"id":"/docs/extend/tools-40","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"the tool being called"},"2281":{"id":"/docs/extend/tools-41","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"arguments"},"2282":{"id":"/docs/extend/tools-42","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"frozen before policy runs; read-only input"},"2283":{"id":"/docs/extend/tools-43","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"sessionId"},"2284":{"id":"/docs/extend/tools-44","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"the session this call belongs to"},"2285":{"id":"/docs/extend/tools-45","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"signal"},"2286":{"id":"/docs/extend/tools-46","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"cancels this call; a tools/execute wrapper may replace it to impose a deadline, but not remove it"},"2287":{"id":"/docs/extend/tools-47","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"token"},"2288":{"id":"/docs/extend/tools-48","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"opaque identity for this dispatch, stable across the whole pipeline"},"2289":{"id":"/docs/extend/tools-49","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"inject(content, source?)"},"2290":{"id":"/docs/extend/tools-50","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#the-exec-handle","content":"append model-visible context the next request will carry"},"2291":{"id":"/docs/extend/tools-51","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#next","content":"Code Mode — where the canonical value earns its keep"},"2292":{"id":"/docs/extend/tools-52","page_id":"/docs/extend/tools","tags":[],"type":"text","url":"/docs/extend/tools#next","content":"Execution seams — where a tool's file and process access actually goes"},"2293":{"id":"/docs/workflows/dynamic","page_id":"/docs/workflows/dynamic","type":"page","content":"Dynamic workflows (experimental)","breadcrumbs":["Documentation","Workflows"],"tags":[],"url":"/docs/workflows/dynamic"},"2294":{"id":"/docs/workflows/dynamic-0","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic","content":"NL-generated DAGs, graph plugins, and save-to-static"},"2295":{"id":"/docs/workflows/dynamic-1","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#when-to-use","content":"When to use"},"2296":{"id":"/docs/workflows/dynamic-2","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#requirements","content":"Requirements"},"2297":{"id":"/docs/workflows/dynamic-3","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Config (DynamicWorkflowsConfig)"},"2298":{"id":"/docs/workflows/dynamic-4","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#repeat-detection","content":"Repeat detection"},"2299":{"id":"/docs/workflows/dynamic-5","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#lifecycle-and-events","content":"Lifecycle and events"},"2300":{"id":"/docs/workflows/dynamic-6","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#save-as-static-workflow","content":"Save as static workflow"},"2301":{"id":"/docs/workflows/dynamic-7","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#graph-plugin-ui","content":"Graph plugin (UI)"},"2302":{"id":"/docs/workflows/dynamic-8","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#wire-client","content":"Wire client"},"2303":{"id":"/docs/workflows/dynamic-9","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#promote-dynamic--static","content":"Promote dynamic → static"},"2304":{"id":"/docs/workflows/dynamic-10","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#limitations-current-code","content":"Limitations (current code)"},"2305":{"id":"/docs/workflows/dynamic-11","page_id":"/docs/workflows/dynamic","type":"heading","tags":[],"url":"/docs/workflows/dynamic#related","content":"Related"},"2306":{"id":"/docs/workflows/dynamic-12","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic","content":"Experimental / unstable: APIs live under experimental.dynamicWorkflows and may change between minors. The graph is drafted by the planning-routed model and validated strictly; when the draft is unusable a fixed 3-node template runs instead."},"2307":{"id":"/docs/workflows/dynamic-13","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic","content":"Dynamic workflows turn each session.send() into: generate a DAG → run nodes in dependency order → optionally prompt to save the graph as a static workflow definition."},"2308":{"id":"/docs/workflows/dynamic-14","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"Use dynamic"},"2309":{"id":"/docs/workflows/dynamic-15","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"Use static workflows instead"},"2310":{"id":"/docs/workflows/dynamic-16","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"User describes a task in chat; you want a visual DAG"},"2311":{"id":"/docs/workflows/dynamic-17","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"Pipeline is fixed at deploy time"},"2312":{"id":"/docs/workflows/dynamic-18","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"Prototype repeat detection → save as template"},"2313":{"id":"/docs/workflows/dynamic-19","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"Production cron / API without NL"},"2314":{"id":"/docs/workflows/dynamic-20","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"React Flow or custom graph UI via plugins"},"2315":{"id":"/docs/workflows/dynamic-21","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#when-to-use","content":"Headless agent.workflows.run(id) only"},"2316":{"id":"/docs/workflows/dynamic-22","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#requirements","content":"Both must be set:"},"2317":{"id":"/docs/workflows/dynamic-23","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#requirements","content":"workflows: {} — memory store (for saveWorkflow)"},"2318":{"id":"/docs/workflows/dynamic-24","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#requirements","content":"experimental.dynamicWorkflows.enabled: true"},"2319":{"id":"/docs/workflows/dynamic-25","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#requirements","content":"When dynamic mode is on, session.send does not run the normal reasoning loop — it only runs the dynamic pipeline and returns the last node’s output."},"2320":{"id":"/docs/workflows/dynamic-26","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#requirements","content":"In-process demo: examples/workflow-demo/src/dynamic.ts (pnpm example:workflow:dynamic)."},"2321":{"id":"/docs/workflows/dynamic-27","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Field"},"2322":{"id":"/docs/workflows/dynamic-28","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Default"},"2323":{"id":"/docs/workflows/dynamic-29","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Behavior"},"2324":{"id":"/docs/workflows/dynamic-30","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"enabled"},"2325":{"id":"/docs/workflows/dynamic-31","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"false"},"2326":{"id":"/docs/workflows/dynamic-32","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Switches session send to dynamic runner"},"2327":{"id":"/docs/workflows/dynamic-33","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"autoPromptSave"},"2328":{"id":"/docs/workflows/dynamic-34","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"true"},"2329":{"id":"/docs/workflows/dynamic-35","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Emit workflow:save:prompt when repeat threshold met"},"2330":{"id":"/docs/workflows/dynamic-36","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"repeatAfter"},"2331":{"id":"/docs/workflows/dynamic-37","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"2"},"2332":{"id":"/docs/workflows/dynamic-38","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Min similar runs (including current) to prompt save"},"2333":{"id":"/docs/workflows/dynamic-39","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"similarityThreshold"},"2334":{"id":"/docs/workflows/dynamic-40","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"0.82"},"2335":{"id":"/docs/workflows/dynamic-41","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#config-dynamicworkflowsconfig","content":"Minimum task similarity (see below)"},"2336":{"id":"/docs/workflows/dynamic-42","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#repeat-detection","content":"Similarity is the cosine of provider.embed() vectors when the provider returns real embeddings (8+ dimensions). Providers without an embedding endpoint (Anthropic, the mock) return a placeholder, so the task texts are compared instead: token-set Jaccard overlap, ignoring case, punctuation and common stopwords. \"Summarise this week's support tickets for the product team\" and \"…for the engineering team\" score about 0.7; an unrelated task scores near 0."},"2337":{"id":"/docs/workflows/dynamic-43","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"WorkflowGraph shape (experimental):"},"2338":{"id":"/docs/workflows/dynamic-44","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"generateWorkflowGraph asks the session's planning-routed model (provider.routing.planning, else the default model) for JSON: { name, nodes: [{ id, type: \"tool\", tool, args, depends } | { id, type: \"ai\", prompt, input, depends }] }, given each tool's description and argument schema. Validation (parseWorkflowGraph):"},"2339":{"id":"/docs/workflows/dynamic-45","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"ids are short [A-Za-z0-9_] and unique; 1–8 nodes;"},"2340":{"id":"/docs/workflows/dynamic-46","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"a tool node naming a tool the agent does not have becomes an AI node;"},"2341":{"id":"/docs/workflows/dynamic-47","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"depends keeps known ids and gains any node a {{id.result}} template references;"},"2342":{"id":"/docs/workflows/dynamic-48","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"a cycle, a bad id or an empty/oversized graph rejects the draft."},"2343":{"id":"/docs/workflows/dynamic-49","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"Any failure falls back to the template graph (first registered tool → ai → ai). The drafting call's usage is reported on cost:update. Override in tests with __test.dynamicGraph on createAgent."},"2344":{"id":"/docs/workflows/dynamic-50","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#lifecycle-and-events","content":"AI nodes run without tools and do not stream stream:token; the session's done carries the last node's output, and each node's result is on workflow:step:done.output. With telemetry on, each run is one trace: a workflow.run root (generated: true, workflowId, workflowName) with the node spans under it, so it appears on the admin Workflows page."},"2345":{"id":"/docs/workflows/dynamic-51","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#save-as-static-workflow","content":"After workflow:save:prompt, persist via session:"},"2346":{"id":"/docs/workflows/dynamic-52","page_id":"/docs/workflows/dynamic","tags":[],"type":"text","url":"/docs/workflows/dynamic#save-as-static-workflow","content":"Vitest