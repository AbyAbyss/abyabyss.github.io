ncated summary and can call __expand_result with { handle }. Set false for full inline results (Cursor-like scratch agents)."},"177":{"id":"/docs/config-reference-175","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"compactToolResultsAbove"},"178":{"id":"/docs/config-reference-176","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"2048"},"179":{"id":"/docs/config-reference-177","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#context--tool-result-handles","content":"Char threshold (JSON.stringify length) before truncating tool message text when handles enabled. Use 200 for prior aggressive behavior."},"180":{"id":"/docs/config-reference-178","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Dual workspace: project folder plus optional per-session scratch (temp scripts, images, SVG). Requires @agentkit/workspace on macOS, Linux, or Windows."},"181":{"id":"/docs/config-reference-179","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Field"},"182":{"id":"/docs/config-reference-180","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Default"},"183":{"id":"/docs/config-reference-181","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"Description"},"184":{"id":"/docs/config-reference-182","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"project"},"185":{"id":"/docs/config-reference-183","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#workspace-workspace","content":"process.cwd()"},"186"