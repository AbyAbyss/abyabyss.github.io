/ui/client-48","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"{ conversation, pending, workflow, plan, todos, usage }; emptySessionState for a session it hasn't seen"},"1119":{"id":"/docs/ui/client-49","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"sessions() / subscribe(fn)"},"1120":{"id":"/docs/ui/client-50","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"Ids it knows (from events, session(), seed(), create()), in order; fn runs after any change"},"1121":{"id":"/docs/ui/client-51","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"seed(id) / create() / forget(id)"},"1122":{"id":"/docs/ui/client-52","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"Load history; start a session; drop one's state"},"1123":{"id":"/docs/ui/client-53","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"status / onStatus(fn) / close()"},"1124":{"id":"/docs/ui/client-54","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"The shared stream"},"1125":{"id":"/docs/ui/client-55","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-hub","content":"options are connect()'s (token, tenant, reconnect) plus conversation (passed to reduceConversation, e.g. { includeNested: true }). The hub loads the saved workflows (GET /workflows) on each (re)connect so a run shows every step up front."},"1126":{"id":"/docs/ui/client-56","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"Pure reducers turn the event stream into the state a UI renders. They are (state, event) => state, so they work in any framework, in tests and in a plain <script type=\"module\">."},"1127":{"id":"/docs/ui/client-57","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"Reducer"},"1128":{"id":"/docs/ui/client-58","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"State"},"1129":{"id":"/docs/ui/client-59","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"reduceConversation"},"1130":{"id":"/docs/ui/client-60","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"{ messages: [{ id, role, text, thinking?, tools, artifacts, parts, status, error? }], streaming } (status: streaming / done / stopped / error; stopped when the run was stopped, from done with status: \"stopped\") — parts interleave text, thinking, tool calls and questions (with the user's answer, from the local client:answer event); workflow-step and subagent events (scope) are left out unless { includeNested: true }"},"1131":{"id":"/docs/ui/client-61","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"reducePending"},"1132":{"id":"/docs/ui/client-62","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"{ approvals, questions } — cleared by approval:resolved / elicitation:resolved, the gated tool's result, and run end"},"1133":{"id":"/docs/ui/client-63","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"reduceWorkflowRun"},"1134":{"id":"/docs/ui/client-64","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"{ runs: [{ runId, workflowId, name, graph?, steps: [{ id, kind, label, tool?, input?, prompt?, status, output? }], status, output?, error? }], generating?, savePrompt? }"},"1135":{"id":"/docs/ui/client-65","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#ui-state","content":"reduceUsage"},"1136":{"id":"/docs/ui/client-66","page_id":"/docs/ui/client",