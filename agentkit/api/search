es Ollama running)."},"974":{"id":"/docs/capabilities/providers-72","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"These built-ins use createOpenAICompatibleProvider against each vendor's OpenAI-compatible endpoint:"},"975":{"id":"/docs/capabilities/providers-73","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"Shorthand"},"976":{"id":"/docs/capabilities/providers-74","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"Base URL"},"977":{"id":"/docs/capabilities/providers-75","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"Env key"},"978":{"id":"/docs/capabilities/providers-76","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"\"gemini\""},"979":{"id":"/docs/capabilities/providers-77","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"https://generativelanguage.googleapis.com/v1beta/openai"},"980":{"id":"/docs/capabilities/providers-78","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"GEMINI_API_KEY or GOOGLE_API_KEY"},"981":{"id":"/docs/capabilities/providers-79","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"\"mistral\""},"982":{"id":"/docs/capabilities/providers-80","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"https://api.mistral.ai/v1"},"983":{"id":"/docs/capabilities/providers-81","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"MISTRAL_API_KEY"},"984":{"id":"/docs/capabilities/providers-82","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"\"groq\""},"985":{"id":"/docs/capabilities/providers-83","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"https://api.groq.com/openai/v1"},"986":{"id":"/docs/capabilities/providers-84","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#gemini-mistral-and-groq","content":"GROQ_API_KEY"},"987":{"id":"/docs/capabilities/providers-85","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"NVIDIA Nemotron runs on several hosts, and AgentKit supports each of them. Pick one in config; nothing else in your agent changes."},"988":{"id":"/docs/capabilities/providers-86","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Host"},"989":{"id":"/docs/capabilities/providers-87","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Provider"},"990":{"id":"/docs/capabilities/providers-88","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Env key"},"991":{"id":"/docs/capabilities/providers-89","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Sizes"},"992":{"id":"/docs/capabilities/providers-90","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Nebius Token Factory"},"993":{"id":"/docs/capabilities/providers-91","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"\"nebius\""},"994":{"id":"/docs/capabilities/providers-92","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"NEBIUS_API_KEY"},"995":{"id":"/docs/capabilities/providers-93","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"nano, super, ultra"},"996":{"id":"/docs/capabilities/providers-94","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"NVIDIA API catalog (build.nvidia.com)"},"997":{"id":"/docs/capabilities/providers-95","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"\"nvidia\""},"998":{"id":"/docs/capabilities/providers-96","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"NVIDIA_API_KEY"},"999":{"id":"/docs/capabilities/providers-97","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"nano, super, ultra"},"1000":{"id":"/docs/capabilities/providers-98","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Your own NIM"},"1001":{"id":"/docs/capabilities/providers-99","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"\"nvidia\" + NVIDIA_BASE_URL"},"1002":{"id":"/docs/capabilities/providers-100","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"as your NIM needs"},"1003":{"id":"/docs/capabilities/providers-101","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"what you deploy"},"1004":{"id":"/docs/capabilities/providers-102","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Ollama (local)"},"1005":{"id":"/docs/capabilities/providers-103","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"\"ollama\""},"1006":{"id":"/docs/capabilities/providers-104","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"none"},"1007":{"id":"/docs/capabilities/providers-105","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"nano, super"},"1008":{"id":"/docs/capabilities/providers-106","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"nemotron(size, host) returns the provider/model id, so the host is one word in config:"},"1009":{"id":"/docs/capabilities/providers-107","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Ids work with or without the provider prefix: on \"nvidia\", \"nvidia/nemotron-3-ultra-550b-a55b\" and nemotron(\"ultra\", \"nvidia\") name the same model."},"1010":{"id":"/docs/capabilities/providers-108","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Reasoning. Nemotron reasons before it answers, which can multiply output tokens (a one-line answer from Nano took 3,703 tokens with reasoning, 117 without). thinking: false in createAgent, or per run (session.send(input, { thinking: false })), turns it off on Nebius, NVIDIA and Ollama."},"1011":{"id":"/docs/capabilities/providers-109","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"Cost. Each size is priced at its own Nebius list price (per million tokens: Ultra $1 in / $3 out, Super $0.30 / $0.90, Nano $0.06 / $0.24), so the console's cost is per model. The \"nvidia\" provider counts $0, since the hosted catalog runs on free credits and a NIM is your own hardware; pass inputCostPerToken / outputCostPerToken to createNvidiaProvider, or call registerModelPrice, to track a paid deployment."},"1012":{"id":"/docs/capabilities/providers-110","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#nemotron-on-any-host","content":"The ids live in NEMOTRON_MODELS. Any other OpenAI-compatible host that serves Nemotron (OpenRouter, vLLM, your gateway) works through registerProvider as shown below. createNvidiaProvider({ apiKey?, baseURL? }) builds the NVIDIA provider directly."},"1013":{"id":"/docs/capabilities/providers-111","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#openai-compatible-gateways","content":"For Azure, LiteLLM, vLLM, or any OpenAI-style /chat/completions API:"},"1014":{"id":"/docs/capabilities/providers-112","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#openai-compatible-gateways","content":"createOpenAICompatibleProvider({ baseURL, apiKey?, id?, inputCostPerToken?, outputCostPerToken? }) returns a Provider suitable for registerProvider."},"1015":{"id":"/docs/capabilities/providers-113","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#session-model-api-agentmodels","content":"When userConfigurable: true (or for registry-only operations), wire clients and React hooks can manage models:"},"1016":{"id":"/docs/capabilities/providers-114","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#session-model-api-agentmodels","content":"Events: models:changed, models:test:result, models:usage:update. Custom provider factories beyond anthropic/openai/ollama/mock require registerProvider (advanced)."},"1017":{"id":"/docs/capabilities/providers-115","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#session-model-api-agentmodels","content":"A single run can use another model without changing the default: session.send(input, { model: \"fast\" }) takes a registry id or a provider/model id."},"1018":{"id":"/docs/capabilities/providers-116","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#picking-a-provider-from-the-environment","content":"detectProviders(env = process.env) returns every built-in provider whose API key is set, in priority order (Anthropic, OpenAI, Gemini, Mistral, Groq, Nebius, NVIDIA), as { id, provider, model, apiKey } with the provider's default model:"},"1019":{"id":"/docs/capabilities/providers-117","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#offline-rule-based-model-createruleprovider","content":"For demos and tests that should react to what the user types (unlike a fixed __test.mockScript). Each rule matches the latest user message (regex) or a predicate over the conversation, and replies with text, thinking, toolCalls, or a function of the context returning any of those. A tool-call reply whose tools already returned this turn is skipped, so \"call the tool\" followed by \"answer from its result\" sequences a turn; repeat: true on a rule plays it anyway (polling, the same tool with new arguments). fallback answers when nothing matches, and usage fixes the reported usage (a reply may set its own)."},"1020":{"id":"/docs/capabilities/providers-118","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#offline-rule-based-model-createruleprovider","content":"The context a rule sees: messages, lastUser (context a runtime injects mid-turn is not counted as the user), toolResults (this turn), results (the same, decoded: { name, value } with JSON parsed and compacted results unwrapped), tools (names offered), system, and match (the regex result)."},"1021":{"id":"/docs/capabilities/providers-119","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#related","content":"Models & switching — Pattern E, wire parity, presets, extension levels"},"1022":{"id":"/docs/capabilities/providers-120","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#related","content":"Configuration reference — full createAgent table and model routes"},"1023":{"id":"/docs/capabilities/providers-121","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#related","content":"Logging & observability — cost:update per model"},"1024":{"id":"/docs/capabilities/providers-122","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#related","content":"examples/ollama-local — local Ollama agent with /models routes"},"1025":{"id":"/docs/capabilities/providers-123","page_id":"/docs/capabilities/providers","tags":[],"type":"text","url":"/docs/capabilities/providers#related","content":"examples/node-backend — headless agent.run() with a single provider"},"1026":{"id":"/docs/capabilities/sources","page_id":"/docs/capabilities/sources","type":"page","content":"Sources","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/sources"},"1027":{"id":"/docs/capabilities/sources-0","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources","content":"Read-only MCP context in the prompt"},"1028":{"id":"/docs/capabilities/sources-1","page_id":"/docs/capabilities/sources","type":"heading","tags":[],"url":"/docs/capabilities/sources#classification","content":"Classification"},"1029":{"id":"/docs/capabilities/sources-2","page_id":"/docs/capabilities/sources","type":"heading","tags":[],"url":"/docs/capabilities/sources#prompt-shape","content":"Prompt shape"},"1030":{"id":"/docs/capabilities/sources-3","page_id":"/docs/capabilities/sources","type":"heading","tags":[],"url":"/docs/capabilities/sources#task-aware-tool-list","content":"Task-aware tool list"},"1031":{"id":"/docs/capabilities/sources-4","page_id":"/docs/capabilities/sources","type":"heading","tags":[],"url":"/docs/capabilities/sources#related","content":"Related"},"1032":{"id":"/docs/capabilities/sources-5","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources","content":"Sources are read-only inputs: MCP resources and MCP tools explicitly classified as source (by kind or a classify override). Every other MCP tool, including read-named ones like list_*, get_* or fetch_*, reaches the model as a callable tool. They are encoded with @agentkit/encoding and injected into the system context block — not exposed as callable write tools."},"1033":{"id":"/docs/capabilities/sources-6","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources","content":"Use sources when the model should see data (docs, schemas, file trees) without granting a tool that mutates state."},"1034":{"id":"/docs/capabilities/sources-7","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#classification","content":"At init, resources are loaded → buildSourceSnapshots → mcp.refreshSources. The UI receives sources:changed with { sources: [{ id, name }] }."},"1035":{"id":"/docs/capabilities/sources-8","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#prompt-shape","content":"The runtime prepends a block like:"},"1036":{"id":"/docs/capabilities/sources-9","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#prompt-shape","content":"Encoding format follows Context & encoding (context.encoding, default auto)."},"1037":{"id":"/docs/capabilities/sources-10","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#task-aware-tool-list","content":"Callable MCP tools are filtered by getToolsForTask(task) (keyword match on name/description). Sources never appear in that list."},"1038":{"id":"/docs/capabilities/sources-11","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#related","content":"MCP — transports and agent.mcp.resources()"},"1039":{"id":"/docs/capabilities/sources-12","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#related","content":"Context & encoding — TOON vs JSON token savings"},"1040":{"id":"/docs/capabilities/sources-13","page_id":"/docs/capabilities/sources","tags":[],"type":"text","url":"/docs/capabilities/sources#related","content":"showcase — set kind: \"source\" on mock tools to populate the sources panel"},"1041":{"id":"/docs/capabilities/tools","page_id":"/docs/capabilities/tools","type":"page","content":"Tools","breadcrumbs":["Documentation","Capabilities"],"tags":[],"url":"/docs/capabilities/tools"},"1042":{"id":"/docs/capabilities/tools-0","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools","content":"Developer-defined Zod tools merged with MCP"},"1043":{"id":"/docs/capabilities/tools-1","page_id":"/docs/capabilities/tools","type":"heading","tags":[],"url":"/docs/capabilities/tools#define-a-tool","content":"Define a tool"},"1044":{"id":"/docs/capabilities/tools-2","page_id":"/docs/capabilities/tools","type":"heading","tags":[],"url":"/docs/capabilities/tools#report-a-failure-without-throwing","content":"Report a failure without throwing"},"1045":{"id":"/docs/capabilities/tools-3","page_id":"/docs/capabilities/tools","type":"heading","tags":[],"url":"/docs/capabilities/tools#many-tools","content":"Many tools"},"1046":{"id":"/docs/capabilities/tools-4","page_id":"/docs/capabilities/tools","type":"heading","tags":[],"url":"/docs/capabilities/tools#structured-output","content":"Structured output"},"1047":{"id":"/docs/capabilities/tools-5","page_id":"/docs/capabilities/tools","type":"heading","tags":[],"url":"/docs/capabilities/tools#related","content":"Related"},"1048":{"id":"/docs/capabilities/tools-6","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools","content":"tools is an array of ToolDef objects: typed inputs (Zod), descriptions for the model, and execute handlers. At runtime they are normalized and merged with MCP tools that are classified as callable (not sources)."},"1049":{"id":"/docs/capabilities/tools-7","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools","content":"Define tools when you own the business logic (deploy, query DB, call internal APIs). Prefer MCP when a standard server already exists."},"1050":{"id":"/docs/capabilities/tools-8","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#define-a-tool","content":"Tool lifecycle events: tool:call, tool:result, tool:error. MCP tools use the mcp:tool:* variants when invoked via the MCP manager."},"1051":{"id":"/docs/capabilities/tools-9","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#report-a-failure-without-throwing","content":"Throwing from execute fails the call, and the model gets the error message. When the model\nshould still see the whole result (a command's exit code and output, a partial response),\nreturn it with isError: true and an optional error. The model gets the full result, and the\ncall is recorded as failed: a red tool span with that error in traces, counted in the trace's\n\"N failed calls\" badge and found by the has:error filter."},"1052":{"id":"/docs/capabilities/tools-10","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#report-a-failure-without-throwing","content":"The workspace run_command tool does this for a non-zero exit."},"1053":{"id":"/docs/capabilities/tools-11","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#many-tools","content":"With more than 30 tools, or about 10k tokens of definitions, tool search turns on: each model\ncall gets the likely tools, the rest are listed by group, and a search_tools tool loads more.\nSee Context: tool search."},"1054":{"id":"/docs/capabilities/tools-12","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#structured-output","content":"Pass a Zod schema on run() to constrain the final assistant message:"},"1055":{"id":"/docs/capabilities/tools-13","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#related","content":"Approvals — gate deploy and other write tools"},"1056":{"id":"/docs/capabilities/tools-14","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#related","content":"MCP — external tools namespaced as server__tool"},"1057":{"id":"/docs/capabilities/tools-15","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#related","content":"Static workflows — call tools by name in DAG steps"},"1058":{"id":"/docs/capabilities/tools-16","page_id":"/docs/capabilities/tools","tags":[],"type":"text","url":"/docs/capabilities/tools#related","content":"examples/workflow-demo — fetch_issues tool in a workflow"},"1059":{"id":"/docs/ui/client","page_id":"/docs/ui/client","type":"page","content":"Client","breadcrumbs":["Documentation","UI"],"tags":[],"url":"/docs/ui/client"},"1060":{"id":"/docs/ui/client-0","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client","content":"@agentkit/client over AG-UI"},"1061":{"id":"/docs/ui/client-1","page_id":"/docs/ui/client","type":"heading","tags":[],"url":"/docs/ui/client#session-api","content":"Session API"},"1062":{"id":"/docs/ui/client-2","page_id":"/docs/ui/client","type":"heading","tags":[],"url":"/docs/ui/client#several-agents-several-sessions","content":"Several agents, several sessions"},"1063":{"id":"/docs/ui/client-3","page_id":"/docs/ui/client","type":"heading","tags":[],"url":"/docs/ui/client#session-hub","content":"Session hub"},"1064":{"id":"/docs/ui/client-4","page_id":"/docs/ui/client","type":"heading","tags":[],"url":"/docs/ui/client#ui-state","content":"UI state"},"1065":{"id":"/docs/ui/client-5","page_id":"/docs/ui/client","type":"heading","tags":[],"url":"/docs/ui/client#plain-html","content":"Plain HTML"},"1066":{"id":"/docs/ui/client-6","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client","content":"Framework-agnostic browser/Node connector. Handles session creation, the SSE event stream (with auto-reconnect), every REST action the server exposes, and pure reducers that turn events into UI state. It has no dependencies and no Node-only code. When the server uses transport: \"websocket\", connect with a WebSocket client to /events?sessionId=... instead."},"1067":{"id":"/docs/ui/client-7","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client","content":"The stream opens on the first on / onAny / onStatus and re-opens with exponential backoff when it drops. 401 / 403 are final: the status goes to closed with the error."},"1068":{"id":"/docs/ui/client-8","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client","content":"connect() itself fails at once when the server is down. When a page may load before its server, use connectWithRetry(url, { ...options, onRetry?, signal? }): it keeps trying while the server is unreachable (status 0) or answers 5xx, with the same backoff (reconnect; false disables), calls onRetry(error, attempt) before each new attempt, stops when signal aborts, and fails at once on any other answer (401, 404…). The React, Vue and Svelte useAgentSession use it."},"1069":{"id":"/docs/ui/client-9","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client","content":"In the browser the base URL may be a same-origin path (connect(\"/api/agent\"), e.g. a Next.js route using toFetchHandler); it resolves against the page."},"1070":{"id":"/docs/ui/client-10","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"Method"},"1071":{"id":"/docs/ui/client-11","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"Route"},"1072":{"id":"/docs/ui/client-12","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"send(input, { mode?, model?, tools?, budget?, meta? })"},"1073":{"id":"/docs/ui/client-13","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"POST /send — options apply to this run only"},"1074":{"id":"/docs/ui/client-14","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"approve(id) / reject(id) / answer(id, choice) / cancel()"},"1075":{"id":"/docs/ui/client-15","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"POST /approve … /cancel"},"1076":{"id":"/docs/ui/client-16","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"history()"},"1077":{"id":"/docs/ui/client-17","page_id":"/docs/ui/client","tags":[],"type":"text","url":"/docs/ui/client#session-api","content":"GET /history → messages"},"1078":{"id":"/docs/ui/client-18","page_id":"/docs/ui/client","tags":