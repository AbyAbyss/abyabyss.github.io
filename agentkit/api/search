ype":"text","url":"/docs/config-reference#events","content":"models:changed, models:test:result, models:usage:update"},"313":{"id":"/docs/config-reference-311","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"mode:changed"},"314":{"id":"/docs/config-reference-312","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"artifact:produced — a file the agent wrote to its scratch workspace, surfaced for download (workspace.artifacts)"},"315":{"id":"/docs/config-reference-313","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"cost:update, log, done, error"},"316":{"id":"/docs/config-reference-314","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#events","content":"Stream, thinking and tool events raised inside a workflow step or a subagent carry scope: { workflowId?, stepId?, agentId? }; the session's own turn leaves it off, so a chat view can drop scoped events. The event types are importable without runtime code from @agentkit/core/wire (AgentEventMap, WireEvent<K>, every payload type, WorkflowGraph, WorkflowDef, …) for browser bundles."},"317":{"id":"/docs/config-reference-315","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#harness-replay-cli","content":"Binary ships from @agentkit/core. See Harness."},"318":{"id":"/docs/config-reference-316","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#wire-agentkitserver--agentkitclient","content":"serve(agent, { port, host?, transport?, auth?, tenantHeader? }) — transport: 'sse' (default) or 'websocket'; includes model routes and enriched /capabilities"},"319":{"id":"/docs/config-reference-317","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#wire-agentkitserver--agentkitclient","content":"handleModelRoutes(agent, req, res, pathname) — reuse in custom servers (returns true if handled)"},"320":{"id":"/docs/config-reference-318","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#wire-agentkitserver--agentkitclient","content":"connect(baseUrl, { token?, tenant?, sessionId?, reconnect? }) with typed on, onAny, onStatus, send(input, options?), approve / reject / answer / cancel, history, getMode / setMode, editTodo, workflows.*, mcp.*, rag.*, models.*; failures throw AgentKitError { status, message }"},"321":{"id":"/docs/config-reference-319","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#wire-agentkitserver--agentkitclient","content":"connectAgents(baseUrl, opts?) → { list(), agent(id).connect() } for serveAgents(); streamAll(baseUrl, opts?) for GET /events/all"},"322":{"id":"/docs/config-reference-320","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#wire-agentkitserver--agentkitclient","content":"Reducers reduceConversation, reducePending, reduceWorkflowRun, reduceUsage, reduceMcp, reduceEventLog, reduceTodos, reducePlan, and session stores (conversationStore, pendingStore, …) — see Client"},"323":{"id":"/docs/config-reference-321","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#model-routes","content":"Method"},"324":{"id":"/docs/config-reference-322","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#model-routes","content":"Path"},"325":{"id":"/docs/config-reference-323","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#model-routes","content":"Body"},"326":{"id":"/docs/config-reference-324","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/config-reference#model-routes","content":"Response"},"327":{"id":"/docs/config-reference-325","page_id":"/docs/config-reference","tags":[],"type":"text","url":"/docs/conf